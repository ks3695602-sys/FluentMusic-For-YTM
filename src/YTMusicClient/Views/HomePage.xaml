<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    NavigationCacheMode="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Search Header bar -->
            <RowDefinition Height="*" />    <!-- Scrollable Content -->
        </Grid.RowDefinitions>

        <!-- Top Search Bar & Segmented Capsule Header (Exact Apple Music Style) -->
        <Grid Grid.Row="0" Padding="32,10,32,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Centered Slim Search Pill with Inline Clear Button -->
            <Border Grid.Column="1"
                    Width="400" Height="34"
                    CornerRadius="17"
                    Background="#22252C"
                    BorderBrush="#383D48"
                    BorderThickness="1">
                <Grid Padding="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource AccentRedBrush}"
                              VerticalAlignment="Center" Margin="0,0,8,0" />

                    <TextBox x:Name="SearchInputBox"
                             Grid.Column="1"
                             Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                             PlaceholderText="Search music, songs, artists..."
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,4,0,0"
                             FontSize="12"
                             VerticalAlignment="Center"
                             KeyDown="SearchInputBox_KeyDown" />

                    <!-- Inline Clear Button (Appears only when typing) -->
                    <Button x:Name="ClearSearchBtn"
                            Grid.Column="2"
                            Click="ClearSearchBtn_Click"
                            Visibility="{x:Bind ViewModel.HasSearchText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Background="Transparent" BorderThickness="0"
                            Width="24" Height="24" CornerRadius="12" Padding="0">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#888888" />
                    </Button>
                </Grid>
            </Border>

            <!-- Right Segmented Source Toggle [ Online | Library ] -->
            <Border Grid.Column="2" HorizontalAlignment="Right"
                    Background="#22252C" BorderBrush="#353942" BorderThickness="1"
                    CornerRadius="14" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Content="Online"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderThickness="0" CornerRadius="12" Padding="12,3" FontSize="11" FontWeight="SemiBold" />
                    <Button Content="Library"
                            Click="LibraryShortcut_Click"
                            Background="Transparent"
                            BorderThickness="0" CornerRadius="12" Padding="12,3" FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,0">
            <StackPanel Spacing="28">

                <!-- Section 1: Top Results > (2-Row x 3-Column Dynamic Gradient Grid) -->
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Top Results"
                                   FontWeight="Bold" FontSize="18" />
                        <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Loading Indicator -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                  Width="32" Height="32" HorizontalAlignment="Left" />

                    <!-- 2x3 Top Results Cards Grid -->
                    <GridView ItemsSource="{x:Bind ViewModel.TopResults, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="TrackCard_Click">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResult">
                                <Border Width="270" Height="68"
                                        Background="{x:Bind GradientStart, Converter={StaticResource HexToBrushConverter}}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8"
                                        Margin="0,0,14,14">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Play Now" Icon="Play" Click="MenuPlayNow_Click" Tag="{x:Bind}" />
                                            <MenuFlyoutItem Text="Play Next" Icon="Next" Click="MenuPlayNext_Click" Tag="{x:Bind}" />
                                            <MenuFlyoutItem Text="Add to Queue" Icon="Add" Click="MenuAddToQueue_Click" Tag="{x:Bind}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Go to Artist" Icon="Contact" Click="MenuGoToArtist_Click" Tag="{x:Bind}" />
                                            <MenuFlyoutItem Text="Copy Link" Icon="Copy" Click="MenuCopyLink_Click" Tag="{x:Bind}" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Album Artwork -->
                                        <Border CornerRadius="6" Width="52" Height="52">
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                 DecodePixelWidth="52" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <!-- Track Metadata -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontWeight="SemiBold" FontSize="12.5"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="11"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Trailing Action Menu Button -->
                                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                                Padding="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Text="Play Now" Icon="Play" Click="MenuPlayNow_Click" Tag="{x:Bind}" />
                                                    <MenuFlyoutItem Text="Play Next" Icon="Next" Click="MenuPlayNext_Click" Tag="{x:Bind}" />
                                                    <MenuFlyoutItem Text="Add to Queue" Icon="Add" Click="MenuAddToQueue_Click" Tag="{x:Bind}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Go to Artist" Icon="Contact" Click="MenuGoToArtist_Click" Tag="{x:Bind}" />
                                                    <MenuFlyoutItem Text="Copy Link" Icon="Copy" Click="MenuCopyLink_Click" Tag="{x:Bind}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Section 2: Artists (Circular Photos with Names Underneath) -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Artists"
                                   FontWeight="Bold" FontSize="18" />
                        <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind ViewModel.TopArtists, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="ArtistItem_Click">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="24" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResult">
                                <StackPanel Width="104" Spacing="8" HorizontalAlignment="Center">
                                    <!-- Circular Artist Avatar -->
                                    <Border Width="96" Height="96" CornerRadius="48"
                                            Background="#25272E" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            HorizontalAlignment="Center">
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                             DecodePixelWidth="96" />
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <!-- Artist Name -->
                                    <TextBlock Text="{x:Bind Artist}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Section 3: Trending & Albums -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Trending &amp; Albums"
                                   FontWeight="Bold" FontSize="18" />
                        <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <GridView ItemsSource="{x:Bind ViewModel.TrendingSongs, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="TrackCard_Click">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResult">
                                <Border Background="{x:Bind GradientStart, Converter={StaticResource HexToBrushConverter}}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8"
                                        Margin="0,0,14,14"
                                        Width="160">
                                    <StackPanel Spacing="8">
                                        <Border CornerRadius="8" Width="144" Height="144">
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                 DecodePixelWidth="144" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="11"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Bottom Spacer so content scrolls completely above the floating player! -->
                <Border Height="110" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
