<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="36,24">
        <StackPanel Spacing="24">
            <!-- Greeting -->
            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                       Style="{StaticResource TitleLargeTextBlockStyle}"
                       FontWeight="Bold" />

            <!-- Quick Picks -->
            <TextBlock Text="Trending Now" Style="{StaticResource SubtitleTextBlockStyle}" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          Width="40" Height="40" />

            <GridView ItemsSource="{x:Bind ViewModel.TrendingSongs, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="TrendingItem_Click">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:SearchResult">
                        <Grid Width="180" Padding="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="180" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" CornerRadius="8">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                     DecodePixelWidth="180" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <TextBlock Grid.Row="1" Text="{x:Bind Title}"
                                       MaxLines="2" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <TextBlock Grid.Row="2" Text="{x:Bind Artist}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
