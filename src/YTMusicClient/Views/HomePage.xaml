<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:converters="using:YTMusicClient.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:StringToUriConverter x:Key="StringToUriConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header with Native WinUI Search Bar -->
            <RowDefinition Height="*" />    <!-- Main Scrollable Content -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header: Official WinUI AutoSuggestBox Search Bar (No Toolbar!) -->
        <Grid Grid.Row="0" Padding="32,16,32,12">
            <AutoSuggestBox x:Name="SearchBox"
                            QueryIcon="Find"
                            PlaceholderText="Search songs, albums, artists... (Ctrl+E)"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            Width="460" Height="36" CornerRadius="18"
                            HorizontalAlignment="Center" />
        </Grid>

        <!-- 2. Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,0">
            <StackPanel Spacing="28">

                <!-- Mood & Genre Category Chips (YouTube Music Style) -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="कसरत (Workout)" CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                Click="MoodChip_Click" Tag="Workout songs" />
                        <Button Content="फील गुड (Feel Good)" CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                Click="MoodChip_Click" Tag="Feel good songs" />
                        <Button Content="रोमांस (Romance)" CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                Click="MoodChip_Click" Tag="Romantic songs" />
                        <Button Content="सुकून (Relax)" CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                Click="MoodChip_Click" Tag="Relaxing acoustic songs" />
                        <Button Content="पार्टी (Party)" CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                Click="MoodChip_Click" Tag="Party dance songs" />
                        <Button Content="फ़ोकस (Focus)" CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                Click="MoodChip_Click" Tag="Lofi focus study music" />
                        <Button Content="अच्छी नींद (Sleep)" CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                Click="MoodChip_Click" Tag="Calm sleep music" />
                        <Button Content="जोश (Energy)" CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                Click="MoodChip_Click" Tag="High energy beats" />
                        <Button Content="दुख भरा (Sad)" CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                Click="MoodChip_Click" Tag="Sad soulful songs" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Loading Ring -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                              HorizontalAlignment="Center" Width="36" Height="36" />

                <!-- Section 1: Quick Picks / Top Songs (1-Click Play Rows) -->
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Quick Picks" FontWeight="Bold" FontSize="18" />
                        <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <GridView ItemsSource="{x:Bind ViewModel.TopResults, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="TrackCard_Click">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResult">
                                <Border Background="#1E2128"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8"
                                        Margin="0,0,12,12"
                                        Width="260">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Album Art -->
                                        <Border Grid.Column="0" CornerRadius="6" Width="48" Height="48">
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                 DecodePixelWidth="48" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <!-- Meta -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- 1-Click Play Icon -->
                                        <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="14"
                                                  Foreground="{StaticResource AccentRedBrush}"
                                                  VerticalAlignment="Center" Margin="0,0,4,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Section 2: WinUI Expanding Gradient Color Hero Boxes (Hover Scale) -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Featured Vibes" FontWeight="Bold" FontSize="18" />

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Box 1: Bollywood Romance -->
                        <Border Grid.Column="0" CornerRadius="14" Height="110" Padding="14"
                                PointerEntered="HeroCard_PointerEntered" PointerExited="HeroCard_PointerExited"
                                PointerPressed="HeroCard_PointerPressed" Tag="Bollywood Romance Songs">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8A2387" Offset="0" />
                                    <GradientStop Color="#E94057" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="Bollywood" FontSize="11" Opacity="0.8" Foreground="White" />
                                    <TextBlock Text="Pure Romance" FontSize="15" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <!-- Box 2: Midnight Chill -->
                        <Border Grid.Column="1" CornerRadius="14" Height="110" Padding="14"
                                PointerEntered="HeroCard_PointerEntered" PointerExited="HeroCard_PointerExited"
                                PointerPressed="HeroCard_PointerPressed" Tag="Lofi chill beats">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00c6ff" Offset="0" />
                                    <GradientStop Color="#0072ff" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="Night Drive" FontSize="11" Opacity="0.8" Foreground="White" />
                                    <TextBlock Text="Midnight Chill" FontSize="15" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <!-- Box 3: Workout Motivation -->
                        <Border Grid.Column="2" CornerRadius="14" Height="110" Padding="14"
                                PointerEntered="HeroCard_PointerEntered" PointerExited="HeroCard_PointerExited"
                                PointerPressed="HeroCard_PointerPressed" Tag="Gym workout motivation songs">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#f12711" Offset="0" />
                                    <GradientStop Color="#f5af19" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="High Energy" FontSize="11" Opacity="0.8" Foreground="White" />
                                    <TextBlock Text="Workout Beast" FontSize="15" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <!-- Box 4: Punjabi Hits -->
                        <Border Grid.Column="3" CornerRadius="14" Height="110" Padding="14"
                                PointerEntered="HeroCard_PointerEntered" PointerExited="HeroCard_PointerExited"
                                PointerPressed="HeroCard_PointerPressed" Tag="Top Punjabi hits 2026">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#11998e" Offset="0" />
                                    <GradientStop Color="#38ef7d" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="Trending" FontSize="11" Opacity="0.8" Foreground="White" />
                                    <TextBlock Text="Punjabi Fire" FontSize="15" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Section 3: Trending & Albums (फिर से सुनें) -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Trending &amp; Albums" FontWeight="Bold" FontSize="18" />
                        <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <GridView ItemsSource="{x:Bind ViewModel.TrendingSongs, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="TrackCard_Click">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResult">
                                <Border Background="#1E2128"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8"
                                        Margin="0,0,14,14"
                                        Width="160">
                                    <StackPanel Spacing="8">
                                        <Border CornerRadius="8" Width="144" Height="144">
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                 DecodePixelWidth="144" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Bottom Spacer so content scrolls completely above the floating player! -->
                <Border Height="110" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
