<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:converters="using:YTMusicClient.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:StringToUriConverter x:Key="StringToUriConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header with Search Bar -->
            <RowDefinition Height="*" />    <!-- Main Scrollable Content -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header: macOS Apple Music / FluentMusic Android Style Header & Search Pill -->
        <Grid Grid.Row="0" Padding="32,20,32,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Hero Header Title & Account Sync Pill -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="HomeHeaderTitle" Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" FontSize="28" FontWeight="Bold" CharacterSpacing="-30" />
                    
                    <!-- Account Synced Status Pill -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981" />
                            <TextBlock Text="{x:Bind ViewModel.AccountStatusDisplay, Mode=OneWay}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Refresh Feed Button -->
                    <Button Click="RefreshFeed_Click" ToolTipService.ToolTip="Refresh Home Feed"
                            Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="12">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="HomeHeaderSubtitle" Text="Quick picks, personalized mixes, and lossless studio masters synced with your library"
                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Floating Search Capsule (Apple Music Pill) -->
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                            QueryIcon="Find"
                            PlaceholderText="Search songs, albums, artists... (Ctrl+E)"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            Width="360" Height="36" CornerRadius="18"
                            VerticalAlignment="Center" />
        </Grid>

        <!-- 2. Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,40">
            <StackPanel Spacing="24">

                <!-- Dynamic Mood & Category Chips Carousel -->
                <ListView ItemsSource="{x:Bind ViewModel.MoodChips, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="MoodChip_ItemClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MoodChip">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="16" Padding="14,6">
                                <TextBlock Text="{x:Bind Title}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Loading Ring -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                              HorizontalAlignment="Center" Width="36" Height="36" />

                <!-- QUICK PICKS (4x2 Responsive Grid - FluentMusic Android Parity) -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasQuickPicks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="START RADIO FROM A SONG" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="50" />
                            <TextBlock Text="Quick Picks" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="PlayQuickPicks_Click"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                CornerRadius="14" Padding="14,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Play All" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 4x2 Grid of Quick Picks Tiles -->
                    <GridView ItemsSource="{x:Bind ViewModel.QuickPicks, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="ShelfItem_Click">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResult">
                                <Border Width="280" Height="64" CornerRadius="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8" Margin="0,0,10,10">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Play Now" Click="MenuPlayNow_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Play Next" Click="MenuPlayNext_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE893;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Add to Queue" Click="MenuAddToQueue_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Download FLAC / Lossless" Click="MenuDownload_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Album Artwork with Hover Play -->
                                        <Border Grid.Column="0" CornerRadius="6">
                                            <Grid>
                                                <Image Stretch="UniformToFill">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                     DecodePixelWidth="48" />
                                                    </Image.Source>
                                                </Image>
                                                <Border Width="24" Height="24" CornerRadius="12"
                                                        Background="{StaticResource AccentRedBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Opacity="0.85">
                                                    <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="White"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Song Title & Artist -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Audio Tier Pill Badge -->
                                        <Border Grid.Column="2" VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="LOSSLESS" FontSize="9" FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </StackPanel>

                <!-- VIEW A: Personalized Dynamic YouTube Music Shelves (Listen again, Quick picks, Forgotten favorites, etc.) -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Shelves, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.HasPersonalizedShelves, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="12" Margin="0,0,0,28">
                                <!-- Shelf Header -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Click="PlayShelf_Click"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                                CornerRadius="14" Padding="14,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{StaticResource AccentRedBrush}" />
                                                <TextBlock Text="Play All" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="PlayShelf_Click"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                                CornerRadius="14" Padding="12,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B1;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="Shuffle" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Shelf Horizontal Carousel -->
                                <ListView ItemsSource="{Binding Items}"
                                          SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="ShelfItem_Click"
                                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Enabled"
                                          ScrollViewer.VerticalScrollMode="Disabled">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="160" Height="220" CornerRadius="10"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    Padding="8">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Play Now" Click="MenuPlayNow_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE768;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Play Next" Click="MenuPlayNext_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE893;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Add to Queue" Click="MenuAddToQueue_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE710;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Download FLAC / Lossless" Click="MenuDownload_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE896;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="144" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Thumbnail Art -->
                                                    <Border Grid.Row="0" CornerRadius="8">
                                                        <Grid>
                                                            <Image Stretch="UniformToFill">
                                                                <Image.Source>
                                                                    <BitmapImage UriSource="{Binding ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                                 DecodePixelWidth="144" />
                                                                </Image.Source>
                                                            </Image>

                                                            <!-- Hover Play Circle Overlay -->
                                                            <Border Width="36" Height="36" CornerRadius="18"
                                                                    Background="{StaticResource AccentRedBrush}"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    Margin="0,0,8,8" Opacity="0.9">
                                                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="White"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Titles -->
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,6,2,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Artist}" FontSize="10.5"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- VIEW B: Fallback / Search Results (When search query is active or personalized shelves empty) -->
                <StackPanel Spacing="24"
                            Visibility="{x:Bind ViewModel.HasPersonalizedShelves, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Search &amp; Trending Results" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Click="PlayShelf_Click"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                    CornerRadius="14" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{StaticResource AccentRedBrush}" />
                                    <TextBlock Text="Play All" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Search / Trending Grid -->
                    <GridView ItemsSource="{x:Bind ViewModel.TopResults, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="ShelfItem_Click">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResult">
                                <Border Width="260" Height="68" CornerRadius="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Play Now" Click="MenuPlayNow_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE768;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Play Next" Click="MenuPlayNext_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE893;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Add to Queue" Click="MenuAddToQueue_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE710;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Download FLAC / Lossless" Click="MenuDownload_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE896;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="6" Width="52" Height="52">
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                 DecodePixelWidth="52" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
