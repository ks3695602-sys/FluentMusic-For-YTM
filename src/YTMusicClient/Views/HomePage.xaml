<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:converters="using:YTMusicClient.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:StringToUriConverter x:Key="StringToUriConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header with Search Bar -->
            <RowDefinition Height="*" />    <!-- Main Scrollable Content -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header: Native Search Bar -->
        <Grid Grid.Row="0" Padding="32,16,32,12">
            <AutoSuggestBox x:Name="SearchBox"
                            QueryIcon="Find"
                            PlaceholderText="Search songs, albums, artists... (Ctrl+E)"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            Width="480" Height="36" CornerRadius="18"
                            HorizontalAlignment="Center" />
        </Grid>

        <!-- 2. Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,40">
            <StackPanel Spacing="24">

                <!-- Dynamic Mood & Category Chips Carousel (From Innertube or Default) -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.MoodChips, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MoodChip">
                                <Button Content="{x:Bind Title}"
                                        Tag="{x:Bind Param}"
                                        CornerRadius="16" Padding="14,6" FontSize="11" FontWeight="SemiBold"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                        Click="MoodChip_Click" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Loading Ring -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                              HorizontalAlignment="Center" Width="36" Height="36" />

                <!-- VIEW A: Personalized Dynamic YouTube Music Shelves (Listen again, Quick picks, Forgotten favorites, etc.) -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Shelves, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasPersonalizedShelves, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="28" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:HomeShelf">
                            <StackPanel Spacing="12">
                                <!-- Shelf Header -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind Subtitle, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{x:Bind Title}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="PlayShelf_Click"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                            CornerRadius="14" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{StaticResource AccentRedBrush}" />
                                            <TextBlock Text="सब चलाएं (Play all)" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Shelf Horizontal Carousel -->
                                <ListView ItemsSource="{x:Bind Items}"
                                          SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="ShelfItem_Click"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Enabled"
                                          ScrollViewer.VerticalScrollMode="Disabled">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SearchResult">
                                            <Border Width="160" Height="220" CornerRadius="12"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    Padding="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="144" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Thumbnail Art -->
                                                    <Border Grid.Row="0" CornerRadius="8">
                                                        <Grid>
                                                            <Image Stretch="UniformToFill">
                                                                <Image.Source>
                                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                                 DecodePixelWidth="144" />
                                                                </Image.Source>
                                                            </Image>

                                                            <!-- Hover Play Circle Overlay -->
                                                            <Border Width="36" Height="36" CornerRadius="18"
                                                                    Background="{StaticResource AccentRedBrush}"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    Margin="0,0,8,8" Opacity="0.9">
                                                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="White"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Titles -->
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,6,2,0">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold"
                                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Artist}" FontSize="10.5"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- VIEW B: Fallback / Search Results (When search query is active or personalized shelves empty) -->
                <StackPanel Spacing="24"
                            Visibility="{x:Bind ViewModel.HasPersonalizedShelves, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Search &amp; Trending Results" FontSize="20" FontWeight="Bold" />

                    <!-- Search / Trending 2x3 Grid -->
                    <GridView ItemsSource="{x:Bind ViewModel.TopResults, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="ShelfItem_Click">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResult">
                                <Border Width="260" Height="68" CornerRadius="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="6" Width="52" Height="52">
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                 DecodePixelWidth="52" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
