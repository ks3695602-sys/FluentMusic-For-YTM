<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="36,24,36,40">
        <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="SettingsHeaderTitle" Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}"
                           FontWeight="Bold" FontSize="28" />
                <TextBlock x:Name="SettingsHeaderSubtitle" Text="Customize audio fidelity, user account sync, appearance and downloads"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- Modern Segmented Pill Tabs -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="18" Padding="3">
                    <Button x:Name="TabAppearanceBtn" Content="Appearance" Click="Tab_Click" Tag="0"
                            CornerRadius="15" Padding="14,6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" FontWeight="SemiBold" BorderThickness="0" />
                    <Button x:Name="TabLanguageBtn" Content="Language (भाषा)" Click="Tab_Click" Tag="1"
                            CornerRadius="15" Padding="14,6"
                            Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                    <Button x:Name="TabAudioBtn" Content="Audio &amp; Fidelity" Click="Tab_Click" Tag="2"
                            CornerRadius="15" Padding="14,6"
                            Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                    <Button x:Name="TabLyricsBtn" Content="Lyrics &amp; Animations" Click="Tab_Click" Tag="3"
                            CornerRadius="15" Padding="14,6"
                            Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                    <Button x:Name="TabDownloadsBtn" Content="Storage &amp; Cache" Click="Tab_Click" Tag="4"
                            CornerRadius="15" Padding="14,6"
                            Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                    <Button x:Name="TabAccountBtn" Content="Account &amp; Sync" Click="Tab_Click" Tag="5"
                            CornerRadius="15" Padding="14,6"
                            Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                    <Button x:Name="TabAboutBtn" Content="About" Click="Tab_Click" Tag="6"
                            CornerRadius="15" Padding="14,6"
                            Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 0: Appearance -->
            <StackPanel x:Name="SectionAppearance" Spacing="16">
                <TextBlock Text="Appearance &amp; Window Material" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="App Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose between Light, Dark, or System Default"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectedIndex="0" Width="170" CornerRadius="8"
                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="System Default" Tag="Default" />
                                <ComboBoxItem Content="Dark Mode" Tag="Dark" />
                                <ComboBoxItem Content="Light Mode" Tag="Light" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Window Material" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Windows 11 Mica Alt 2-Island modular surface"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="WindowMaterialCombo" Grid.Column="1" SelectedIndex="0" Width="170" CornerRadius="8"
                                      SelectionChanged="WindowMaterialCombo_SelectionChanged">
                                <ComboBoxItem Content="Mica Alt (2-Island)" Tag="MicaAlt" />
                                <ComboBoxItem Content="Desktop Acrylic" Tag="Acrylic" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TAB 1: Language & Localization -->
            <StackPanel x:Name="SectionLanguage" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Language &amp; Region" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="App Interface Language" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Switch between Pure English, Pure Hindi, or Hinglish"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectedIndex="0" Width="200" CornerRadius="8"
                                      SelectionChanged="LanguageCombo_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="English" />
                                <ComboBoxItem Content="हिन्दी (Pure Hindi)" Tag="Hindi" />
                                <ComboBoxItem Content="Hinglish (Mix)" Tag="Hinglish" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TAB 2: Audio & Fidelity -->
            <StackPanel x:Name="SectionAudio" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Audio Fidelity &amp; Playback Source" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Audio Source Engine" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Lossless FLAC studio masters, high-res AAC, or YouTube Music"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="AudioSourceCombo" Grid.Column="1" SelectedIndex="0" Width="220" CornerRadius="8"
                                      SelectionChanged="AudioSourceCombo_SelectionChanged">
                                <ComboBoxItem Content="Lossless FLAC / High-Res" Tag="FLAC" />
                                <ComboBoxItem Content="AAC 256kbps High-Fidelity" Tag="AAC" />
                                <ComboBoxItem Content="YouTube Video Native Audio" Tag="YT" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Equal-Power Crossfade Slider (Echo-Music / ArchiveTune Engine) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Equal-Power Crossfade Duration" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="CrossfadeLabel" Text="Smooth transition between songs: 4.0s"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Slider x:Name="CrossfadeSlider" Grid.Column="1" Minimum="0" Maximum="12" StepFrequency="0.5" Value="4"
                                    ValueChanged="CrossfadeSlider_ValueChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Volume Normalization (ReplayGain) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Volume Normalization (ReplayGain)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Equalizes audio loudness across different albums and songs"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ReplayGainToggle" Grid.Column="1" IsOn="True" Toggled="ReplayGainToggle_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- 1:1 Video Sync -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Video-Audio 1:1 Second Lockstep Sync" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Play high quality FLAC audio in tight second-by-second sync with muted YouTube music video"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="VideoSyncToggle" Grid.Column="1" IsOn="True" Toggled="VideoSyncToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TAB 3: Lyrics & Animations (ArchiveTune Engine) -->
            <StackPanel x:Name="SectionLyrics" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Lyrics Engine &amp; Animations (ArchiveTune)" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <!-- Lyrics Animation Style: V2 vs ENHANCED -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lyrics Animation Style" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose between V2 Liquid Glow &amp; Spring Bounce or Enhanced Syllable Karaoke"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="LyricsStyleCombo" Grid.Column="1" SelectedIndex="0" Width="220" CornerRadius="8"
                                      SelectionChanged="LyricsStyleCombo_SelectionChanged">
                                <ComboBoxItem Content="V2 (Liquid Glow &amp; Spring Bounce)" Tag="V2" />
                                <ComboBoxItem Content="Enhanced (Apple Syllable Karaoke)" Tag="ENHANCED" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Line Bounce Effect Switch -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Line Bounce Effect" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Enable spring bounce animation for line-synced (LRC) lyrics"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="LrcBounceToggle" Grid.Column="1" IsOn="True" Toggled="LrcBounceToggle_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Bounce Amplitude Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Bounce Amplitude" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="BounceLabel" Text="Adjust the bounce effect when a word is sung (100%)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Slider x:Name="BounceSlider" Grid.Column="1" Minimum="0" Maximum="2" StepFrequency="0.1" Value="1.0"
                                    ValueChanged="BounceSlider_ValueChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Glow Intensity Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Glow Intensity" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="GlowLabel" Text="Adjust the glow brightness of the sung word (100%)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Slider x:Name="GlowSlider" Grid.Column="1" Minimum="0" Maximum="2" StepFrequency="0.1" Value="1.0"
                                    ValueChanged="GlowSlider_ValueChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Fill Transition Smoothness Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Fill Transition Smoothness" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="FillLabel" Text="Adjust the gradient edge width of the liquid fill effect (8 px)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Slider x:Name="FillSlider" Grid.Column="1" Minimum="2" Maximum="24" StepFrequency="1" Value="8"
                                    ValueChanged="FillSlider_ValueChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Hindi Romanization (Hinglish) Toggle -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Romanize Hindi Lyrics (Hinglish)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Auto-convert Devanagari Hindi text to Roman phonetic Hinglish"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RomanizeHindiToggle" Grid.Column="1" IsOn="True" Toggled="RomanizeHindiToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TAB 4: Storage & Downloads -->
            <StackPanel x:Name="SectionDownloads" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Offline Downloads &amp; Storage" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Download Audio Quality" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Primary format for offline songs (lossless studio FLAC or 256kbps AAC)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="DownloadQualityCombo" Grid.Column="1" SelectedIndex="0" Width="200" CornerRadius="8"
                                      SelectionChanged="DownloadQualityCombo_SelectionChanged">
                                <ComboBoxItem Content="Lossless FLAC (Studio Quality)" Tag="FLAC" />
                                <ComboBoxItem Content="AAC 256kbps (.m4a)" Tag="AAC" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Download Folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="DownloadFolderPathText" Text="Music/FluentMusic/Downloads"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open Folder" CornerRadius="8" Padding="14,6" Click="OpenDownloadFolder_Click" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Clear Cache -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Audio Streaming Cache" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="CacheStatusText" Text="Calculating cache size..."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="ClearCacheBtn" Grid.Column="1" Content="Clear Cache" CornerRadius="8" Padding="14,6" Click="ClearCache_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TAB 5: Account & Sync -->
            <StackPanel x:Name="SectionAccount" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Google &amp; YouTube Music Account" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Profile Avatar -->
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon x:Name="AccountAvatarIcon" Glyph="&#xE77B;" FontSize="18" Foreground="{StaticResource AccentRedBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="AccountAvatarImage" Width="40" Height="40" Stretch="UniformToFill" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="AccountStatusTitle" Text="YouTube Music Sync" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" />
                                <TextBlock x:Name="AccountStatusSubtitle" Text="Sign in to sync your personal playlists, liked songs, and history inside the app"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button x:Name="SignInGoogleBtn" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                                    CornerRadius="16" Padding="16,8"
                                    Click="SignInWithGoogle_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE77B;" FontSize="13" />
                                    <TextBlock x:Name="SignInGoogleBtnText" Text="Sign in with Google" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TAB 6: About -->
            <StackPanel x:Name="SectionAbout" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="About FluentMusic" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentRedBrush}">
                                <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" FontSize="16">
                                <Run Text="FluentMusic v1.1.0.0" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="A native, high-performance YouTube Music client merging macOS Apple Music elegance with Windows 11 Fluent Design, ArchiveTune Lyrics engine, and lossless audio streaming."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="Built with WinUI 3, Windows App SDK 1.5, .NET 8, and InnerTube Zero-Cipher stream engine."
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>