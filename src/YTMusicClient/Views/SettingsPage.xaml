<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="40,28,40,40">
        <StackPanel Spacing="24" MaxWidth="720" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}"
                           FontWeight="Bold" FontSize="28" />
                <TextBlock Text="Customize your playback experience and visual appearance"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- Appearance Section -->
            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="App Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Choose between Light, Dark, or System Default"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Width="170" CornerRadius="8"
                                  SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="System Default" Tag="Default" />
                            <ComboBoxItem Content="Dark Mode" Tag="Dark" />
                            <ComboBoxItem Content="Light Mode" Tag="Light" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Window Material" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Windows 11 Mica Alt 2-Island modular surface"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Width="170" CornerRadius="8">
                            <ComboBoxItem Content="Mica Alt (2-Island)" Tag="MicaAlt" />
                            <ComboBoxItem Content="Desktop Acrylic" Tag="Acrylic" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Audio & Streaming Section -->
            <TextBlock Text="Audio &amp; Playback" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Audio Quality" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Prioritizes pristine 256kbps/128kbps AAC &amp; OPUS streams"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Bind ViewModel.AudioQualities}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedQualityIndex, Mode=TwoWay}"
                                  Width="170" CornerRadius="8" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Volume Normalization (ReplayGain)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Equalizes audio loudness across different albums and songs"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="True" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Lyrics Section -->
            <TextBlock Text="Lyrics &amp; Karaoke" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Word-by-Word Karaoke Sync" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Real-time syllable and progressive word sweep highlights (YouLy+ style)"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="True" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lyrics Font Size" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Adjust readability of synced lyrics"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="1" Width="170" CornerRadius="8">
                            <ComboBoxItem Content="Compact (14px)" />
                            <ComboBoxItem Content="Standard (18px)" />
                            <ComboBoxItem Content="Large (22px)" />
                            <ComboBoxItem Content="Jumbo (26px)" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Account & Sync Section -->
            <TextBlock Text="Google Account" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YouTube Music Sync" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Sign in to sync your personal playlists, liked songs, and history inside the app"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="18" Padding="16,8"
                            Click="SignInWithGoogle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock Text="Sign in with Google" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- About Section -->
            <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="18" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14" Padding="20,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentRedBrush}">
                            <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Border>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center">
                            <Run Text="FluentMusic v" /><Run Text="{x:Bind ViewModel.AppVersion}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="A native, high-performance YouTube Music client merging macOS elegance with Windows 11 Fluent Design."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Built with WinUI 3 (Windows App SDK), .NET 8, and YoutubeExplode."
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
