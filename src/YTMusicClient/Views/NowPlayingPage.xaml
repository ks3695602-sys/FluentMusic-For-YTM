<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    NavigationCacheMode="Enabled">

    <!-- Immersive Dynamic Liquid Glass Now-Playing Canvas -->
    <Grid Padding="36,20,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header & Mode Switcher -->
            <RowDefinition Height="*" />    <!-- Main 2-Column Stage (Art/Video + Lyrics) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Scrub & Transport Dock -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header & Mode Switcher [ ♫ Song Mode | 🎬 Video Mode ] -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back Chevron Button -->
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                    BorderThickness="0" CornerRadius="18" Width="36" Height="36" Padding="0">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <!-- Center Mode Switcher: [ ♫ Song | 🎬 Video ] -->
            <Border Grid.Column="1" HorizontalAlignment="Center"
                    Background="#24262E" BorderBrush="#383C46" BorderThickness="1"
                    CornerRadius="16" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="SongModeBtn"
                            Content="♫  Song"
                            Click="SongModeBtn_Click"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderThickness="0" CornerRadius="14" Padding="16,4"
                            FontSize="12" FontWeight="SemiBold" />
                    <Button x:Name="VideoModeBtn"
                            Content="🎬  Video"
                            Click="VideoModeBtn_Click"
                            Background="Transparent"
                            BorderThickness="0" CornerRadius="14" Padding="16,4"
                            FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Top-Right Actions (More Options Flyout) -->
            <Button Grid.Column="2"
                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                    BorderThickness="0" CornerRadius="18" Width="36" Height="36" Padding="0">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Play Next" Click="PlayNext_Click" />
                        <MenuFlyoutItem Text="Add to Queue" Click="AddToQueue_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Playback Speed">
                            <MenuFlyoutItem Text="0.5x" Click="Speed_Click" Tag="0.5" />
                            <MenuFlyoutItem Text="0.75x" Click="Speed_Click" Tag="0.75" />
                            <MenuFlyoutItem Text="1.0x (Normal)" Click="Speed_Click" Tag="1.0" />
                            <MenuFlyoutItem Text="1.25x" Click="Speed_Click" Tag="1.25" />
                            <MenuFlyoutItem Text="1.5x" Click="Speed_Click" Tag="1.5" />
                            <MenuFlyoutItem Text="2.0x" Click="Speed_Click" Tag="2.0" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Copy YouTube Music Link" Click="CopyLink_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- 2. Main 2-Column Stage (Left: Big Artwork/Video, Right: Synced Lyrics) -->
        <Grid Grid.Row="1" ColumnSpacing="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" /> <!-- Left: Giant Cover Art or Video -->
                <ColumnDefinition Width="*" />   <!-- Right: Word-to-Word Lyrics -->
            </Grid.ColumnDefinitions>

            <!-- Left: Artwork Mode Container -->
            <Grid x:Name="SongStageContainer" Grid.Column="0" VerticalAlignment="Center" Margin="10,0">
                <StackPanel Spacing="18" HorizontalAlignment="Center">
                    <!-- Giant Floating Artwork with 3D Elevation Shadow -->
                    <Border CornerRadius="20" Width="340" Height="340"
                            Background="#22242B" BorderBrush="#353842" BorderThickness="1">
                        <Image Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage UriSource="{x:Bind PlayerViewModel.ThumbnailUrl, Mode=OneWay, Converter={StaticResource StringToUriConverter}}"
                                             DecodePixelWidth="340" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <!-- Title, Artist & Quality Badge Pill -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind PlayerViewModel.Title, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="20"
                                   TextAlignment="Center" MaxLines="2" TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{x:Bind PlayerViewModel.Artist, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14" TextAlignment="Center"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />

                        <!-- Sleek Audio Quality & Source Badge Pill -->
                        <Border HorizontalAlignment="Center" Margin="0,4,0,0"
                                Background="#1AFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="10,3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="9" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="{x:Bind PlayerViewModel.AudioQualityBadge, Mode=OneWay}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Left: Video Mode Container (Hidden by default) -->
            <Grid x:Name="VideoStageContainer" Grid.Column="0" Visibility="Collapsed" VerticalAlignment="Center">
                <Border CornerRadius="16" Height="280" Background="#111111" BorderBrush="#353842" BorderThickness="1">
                    <WebView2 x:Name="VideoPlayerWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
            </Grid>

            <!-- Right: Synchronized Word-to-Word Lyrics View -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="LYRICS" FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Margin="12,0,0,12" />

                <!-- Lyrics Scrollable List -->
                <ListView x:Name="NowPlayingLyricsList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind LyricsViewModel.Lyrics, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="LyricLine_Click"
                          Padding="0,60,0,220">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:LyricLine">
                            <Border Padding="12,10" Margin="0,4" CornerRadius="10"
                                    Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Text}"
                                               FontSize="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource LyricFontSizeConverter}}"
                                               Opacity="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource LyricOpacityConverter}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- 3. Bottom Scrubber and Transport Dock -->
        <Grid Grid.Row="2" Margin="0,12,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Timeline Scrubber -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind PlayerViewModel.Position, Mode=OneWay, Converter={StaticResource TimeSpanConverter}}"
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />

                <Slider Grid.Column="1" Minimum="0" Maximum="100"
                        Value="{x:Bind PlayerViewModel.ProgressPercent, Mode=TwoWay}"
                        Height="20" Margin="10,0"
                        IsThumbToolTipEnabled="False" />

                <TextBlock Grid.Column="2"
                           Text="{x:Bind PlayerViewModel.Duration, Mode=OneWay, Converter={StaticResource TimeSpanConverter}}"
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <!-- Transport Buttons & Volume Dock -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Center Controls: Shuffle, Prev, Play, Next, Repeat -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                    <Button Command="{x:Bind PlayerViewModel.ToggleShuffleCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="16" Padding="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="15"
                                  Foreground="{x:Bind PlayerViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource ActiveAccentBrushConverter}}" />
                    </Button>

                    <Button Command="{x:Bind PlayerViewModel.PreviousTrackCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="18" Padding="8">
                        <FontIcon Glyph="&#xE892;" FontSize="18" />
                    </Button>

                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind PlayerViewModel.TogglePlayPauseCommand}"
                            Width="44" Height="44" CornerRadius="22" Padding="0">
                        <FontIcon Glyph="{x:Bind PlayerViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseGlyph}}"
                                  FontSize="18" />
                    </Button>

                    <Button Command="{x:Bind PlayerViewModel.NextTrackCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="18" Padding="8">
                        <FontIcon Glyph="&#xE893;" FontSize="18" />
                    </Button>

                    <Button Command="{x:Bind PlayerViewModel.ToggleRepeatCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="16" Padding="8">
                        <FontIcon Glyph="{x:Bind PlayerViewModel.RepeatMode, Mode=OneWay, Converter={StaticResource RepeatModeGlyphConverter}}"
                                  FontSize="15" />
                    </Button>
                </StackPanel>

                <!-- Right Controls: Volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                    <Button Command="{x:Bind PlayerViewModel.ToggleMuteCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="14" Padding="6">
                        <FontIcon Glyph="&#xE767;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <Slider Minimum="0" Maximum="1" Value="{x:Bind PlayerViewModel.Volume, Mode=TwoWay}"
                            StepFrequency="0.01" Width="100" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
