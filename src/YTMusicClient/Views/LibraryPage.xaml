<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:converters="using:YTMusicClient.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:StringToUriConverter x:Key="StringToUriConverter" />
            <converters:TimeSpanToStringConverter x:Key="TimeSpanConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="36,24,36,120" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Your Library" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="Bold" FontSize="28" />
                <TextBlock Text="Your liked music, saved playlists, and synced Google library"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.SyncWithGoogleCommand}"
                        CornerRadius="16" Padding="12,7"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="Sync with Google" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.AddToLikedCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        CornerRadius="16" Padding="14,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEB51;" FontSize="13" />
                        <TextBlock Text="Like Current" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Google Sync Status & Navigation Segment -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Segmented Switcher: Playlists vs Liked Songs -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="18" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="PlaylistsTabBtn" Click="PlaylistsTab_Click"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0"
                            CornerRadius="15" Padding="16,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D6;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                            <TextBlock Text="प्लेलिस्ट (Playlists)" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LikedSongsTabBtn" Click="LikedSongsTab_Click"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="15" Padding="16,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEB51;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                            <TextBlock Text="पसंद किए गए गाने (Liked Songs)" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="16,0,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,6" VerticalAlignment="Center">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#10B981" />
                        <TextBlock Text="Google Account Connected:" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.GoogleUserName, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" Text="Synced with YouTube Music" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">

            <!-- VIEW 1: PLAYLISTS GRID -->
            <Grid x:Name="PlaylistsView"
                  Visibility="{x:Bind ViewModel.IsPlaylistDetailOpen, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search playlists box -->
                <AutoSuggestBox QueryIcon="Find" PlaceholderText="Search your playlists..."
                                Text="{x:Bind ViewModel.PlaylistSearchQuery, Mode=TwoWay}"
                                Width="360" HorizontalAlignment="Left" Margin="0,0,0,16" CornerRadius="16" />

                <!-- Grid of Playlists -->
                <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredPlaylists, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Playlist_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <Border Width="170" Height="230" CornerRadius="12" Margin="0,0,14,14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0" CornerRadius="10">
                                        <Grid>
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                 DecodePixelWidth="150" />
                                                </Image.Source>
                                            </Image>
                                            <!-- Hover Play circle -->
                                            <Border Width="36" Height="36" CornerRadius="18"
                                                    Background="{StaticResource AccentRedBrush}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,8,8" Opacity="0.9">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Playlist Titles -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,6,2,0">
                                        <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="10.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- VIEW 2: PLAYLIST DETAIL VIEW (When a playlist is clicked) -->
            <Grid x:Name="PlaylistDetailView"
                  Visibility="{x:Bind ViewModel.IsPlaylistDetailOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Back button -->
                <Button Grid.Row="0" Command="{x:Bind ViewModel.ClosePlaylistDetailCommand}"
                        Background="Transparent" BorderThickness="0" Margin="0,0,0,14" CornerRadius="8" Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="Back to Playlists" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Playlist Header Details -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="12" Width="140" Height="140"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Image Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage UriSource="{x:Bind ViewModel.SelectedPlaylist.ThumbnailUrl, Mode=OneWay, Converter={StaticResource StringToUriConverter}}"
                                             DecodePixelWidth="140" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0" Spacing="8">
                        <TextBlock Text="PLAYLIST" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedPlaylist.Title, Mode=OneWay}" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedPlaylist.Description, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                        <!-- Action Buttons: Play All, Shuffle -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Button Command="{x:Bind ViewModel.PlayAllPlaylistCommand}"
                                    Style="{StaticResource AccentButtonStyle}" CornerRadius="16" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock Text="Play All" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ShufflePlaylistCommand}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                                    CornerRadius="16" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="12" />
                                    <TextBlock Text="Shuffle" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Tracklist ListView -->
                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.PlaylistTracks, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="PlaylistSong_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Song">
                            <Grid Padding="10,8" Margin="0,3"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1" CornerRadius="10" ColumnSpacing="14">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Play Now" Click="MenuPlayNow_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Play Next" Click="MenuPlayNext_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE893;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Add to Queue" Click="MenuAddToQueue_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE710;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Download FLAC / Lossless" Click="MenuDownload_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE896;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="6" Width="48" Height="48">
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                         DecodePixelWidth="48" />
                                        </Image.Source>
                                    </Image>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" MaxLines="1" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="{x:Bind Duration, Converter={StaticResource TimeSpanConverter}}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />

                                <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{StaticResource AccentRedBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- VIEW 3: LIKED SONGS LIST (Visible when Liked tab clicked) -->
            <ListView x:Name="LikedSongsView"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind ViewModel.LikedSongs, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="LikedSong_Click">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Song">
                        <Grid Padding="10,8" Margin="0,3"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="10" ColumnSpacing="14">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Play Now" Click="MenuPlayNow_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Play Next" Click="MenuPlayNext_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE893;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Add to Queue" Click="MenuAddToQueue_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE710;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Download FLAC / Lossless" Click="MenuDownload_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE896;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="6" Width="48" Height="48">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                     DecodePixelWidth="48" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Artist}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="{x:Bind Duration, Converter={StaticResource TimeSpanConverter}}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />

                            <FontIcon Grid.Column="3" Glyph="&#xEB51;"
                                      Foreground="{StaticResource AccentRedBrush}" FontSize="15"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
