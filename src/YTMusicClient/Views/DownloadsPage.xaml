<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTMusicClient.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:converters="using:YTMusicClient.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:StringToUriConverter x:Key="StringToUriConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="36,24,36,120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Downloads" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="Bold" FontSize="28" />
                <TextBlock Text="Offline music storage available without internet connection"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- Actions: Play All & Open Folder -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButtonStyle}"
                        CornerRadius="16" Padding="14,7"
                        Command="{x:Bind ViewModel.PlayAllCommand}"
                        IsEnabled="{x:Bind ViewModel.HasDownloads, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                        <TextBlock Text="Play All" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button CornerRadius="16" Padding="12,7"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0"
                        Command="{x:Bind ViewModel.OpenFolderCommand}"
                        ToolTipService.ToolTip="Open local downloads folder in File Explorer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                        <TextBlock Text="Open Folder" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stats Pill -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                    <TextBlock Text="Offline Library" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SongCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="tracks saved" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,3">
                    <TextBlock Text="{x:Bind ViewModel.StorageUsedFormatted, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Downloaded Songs List -->
        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.DownloadedSongs, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="DownloadedSong_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <Grid Padding="10,8" Margin="0,3"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1" CornerRadius="10" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Album Art -->
                        <Border Grid.Column="0" CornerRadius="6" Width="48" Height="48">
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                 DecodePixelWidth="48" />
                                </Image.Source>
                            </Image>
                        </Border>

                        <!-- Title & Artist -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13"
                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Artist}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11.5" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Format & File Size Badge -->
                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{x:Bind FileSizeFormatted}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <!-- Delete button -->
                        <Button Grid.Column="3" Background="Transparent" BorderThickness="0" CornerRadius="14"
                                Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                                Click="DeleteSong_Click" Tag="{x:Bind VideoId}"
                                ToolTipService.ToolTip="Delete offline copy">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Header>
                <TextBlock Text="No downloaded songs yet. Click the download icon on any song to save it for offline listening!"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.HasDownloads, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                           Margin="0,32,0,0" TextAlignment="Center" />
            </ListView.Header>
        </ListView>
    </Grid>
</Page>
