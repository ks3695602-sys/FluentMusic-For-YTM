<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YTMusicClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YTMusicClient.Controls"
    Title="FluentMusic">

    <!-- 2-Island Modular Glass Layout on Windows 11 Mica Alt -->
    <Grid Padding="10,8,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" /> <!-- Island 1: Left Floating Sidebar on Mica Alt -->
            <ColumnDefinition Width="*" />   <!-- Island 2: Main Floating Stage Card -->
        </Grid.ColumnDefinitions>

        <!-- ISLAND 1: Left Translucent Sidebar (Mica Alt Canvas) -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Header / Drag Region -->
                <RowDefinition Height="*" />    <!-- Navigation Category Items -->
                <RowDefinition Height="Auto" /> <!-- Bottom User Account & Settings -->
            </Grid.RowDefinitions>

            <!-- Top Draggable Window Header -->
            <Grid x:Name="SidebarDragArea" Grid.Row="0" Height="42" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentRedBrush}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                    </Border>
                    <TextBlock Text="FluentMusic" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Navigation Links -->
            <StackPanel Grid.Row="1" Spacing="4" Margin="4,16,4,0">
                <!-- Home -->
                <Button x:Name="NavHomeBtn" Click="NavHome_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderThickness="0" CornerRadius="10" Padding="12,9">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{StaticResource AccentRedBrush}" />
                        <TextBlock Text="Home" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Explore -->
                <Button x:Name="NavExploreBtn" Click="NavExplore_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,9">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xF6FA;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Explore" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Library -->
                <Button x:Name="NavLibraryBtn" Click="NavLibrary_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,9">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Library" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Bottom Account & Settings Section -->
            <StackPanel Grid.Row="2" Spacing="6" Margin="4,0,4,6">
                <!-- User Profile / Google Account Sync Pill -->
                <Border x:Name="UserAccountPill" CornerRadius="18"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Padding="8,6"
                        PointerPressed="UserAccountPill_PointerPressed"
                        ToolTipService.ToolTip="Google Account &amp; Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                            <FontIcon x:Name="UserAccountAvatarIcon" Glyph="&#xE77B;" FontSize="12" Foreground="{StaticResource AccentRedBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock x:Name="UserAccountStatusTitle" Text="Google Sync" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="UserAccountStatusSub" Text="Sign in to sync" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <FontIcon x:Name="UserAccountStatusIcon" Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  VerticalAlignment="Center" Margin="0,0,4,0" />
                    </Grid>
                </Border>

                <!-- Settings Button -->
                <Button x:Name="NavSettingsBtn" Click="NavSettings_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Settings" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ISLAND 2: Main Floating Stage Card (Mica Surface Layer with Glass Border) -->
        <Border Grid.Column="1"
                CornerRadius="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1">

            <Grid>
                <!-- SplitView for Lyrics Panel Drawer -->
                <SplitView x:Name="LyricsSplitView"
                           IsPaneOpen="{x:Bind ViewModel.IsLyricsPanelOpen, Mode=TwoWay}"
                           PanePlacement="Right"
                           OpenPaneLength="380"
                           DisplayMode="Inline"
                           PaneBackground="Transparent">

                    <!-- Lyrics Drawer Pane -->
                    <SplitView.Pane>
                        <controls:LyricsPanel x:Name="LyricsPanelControl" />
                    </SplitView.Pane>

                    <!-- SplitView Main Content: Page Stage + Floating Capsule Player -->
                    <SplitView.Content>
                        <Grid>
                            <!-- Navigation Content Frame -->
                            <Frame x:Name="ContentFrame" />

                            <!-- Full Stage Now Playing & YouTube Music Video Overlay -->
                            <Grid x:Name="NowPlayingOverlay"
                                  Visibility="Collapsed"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  CornerRadius="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
                                    <RowDefinition Height="*" />    <!-- Content Stage (Song vs Video) -->
                                </Grid.RowDefinitions>

                                <!-- Now Playing Top Bar -->
                                <Grid Grid.Row="0" Padding="24,14,24,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Back / Minimize button -->
                                    <Button Grid.Column="0" Click="CloseNowPlaying_Click"
                                            Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                            <TextBlock Text="Back to Browse" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Mode Toggle: Audio vs Music Video -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="18" Padding="3">
                                        <Button x:Name="NpAudioModeBtn" Click="NpAudioMode_Click"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderThickness="0" CornerRadius="15" Padding="16,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xEC4F;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                                                <TextBlock Text="Audio &amp; Vinyl" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="NpVideoModeBtn" Click="NpVideoMode_Click"
                                                Background="Transparent"
                                                BorderThickness="0" CornerRadius="15" Padding="16,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE714;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="Music Video" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Close Button -->
                                    <Button Grid.Column="2" Click="CloseNowPlaying_Click"
                                            Background="Transparent" BorderThickness="0" CornerRadius="16" Width="32" Height="32" Padding="0">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>

                                <!-- 1. Audio Vinyl & Track Info Mode -->
                                <Grid x:Name="NpAudioStage" Grid.Row="1" Padding="40,20,40,90">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Big Album Artwork with Ambient Shadow -->
                                    <Border Grid.Column="0" Width="360" Height="360" CornerRadius="16"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Image x:Name="NpAlbumImage" Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage x:Name="NpAlbumBitmap" />
                                            </Image.Source>
                                        </Image>
                                    </Border>

                                    <!-- Right: Track Metadata & Audio Fidelity -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="48,0,0,0" Spacing="16">
                                        <Border Background="#20FA2D48" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="{StaticResource AccentRedBrush}" />
                                                <TextBlock x:Name="NpQualityText" Text="256 kbps · AAC · Hi-Res"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="NpTitleText" Text="Not Playing"
                                                   Style="{StaticResource TitleLargeTextBlockStyle}"
                                                   FontWeight="Bold" FontSize="32"
                                                   TextWrapping="Wrap" MaxLines="2" />

                                        <TextBlock x:Name="NpArtistText" Text="Choose a song to start listening"
                                                   FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" MaxLines="1" />

                                        <TextBlock Text="Streaming with ultra-low latency &amp; lossless AAC source"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 2. Music Video Stage (WebView2 16:9 YouTube Player) -->
                                <Grid x:Name="NpVideoStage" Grid.Row="1" Visibility="Collapsed" Padding="20,10,20,90">
                                    <Border CornerRadius="12"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <WebView2 x:Name="NpVideoWebView"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Floating Liquid Glass Player Capsule (Layer 1: Hovers centered above content!) -->
                            <controls:PlayerBar x:Name="PlayerBarControl"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,20" />
                        </Grid>
                    </SplitView.Content>
                </SplitView>
            </Grid>
        </Border>
    </Grid>
</Window>
