<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YTMusicClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YTMusicClient.Controls"
    Title="YT Music">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" /> <!-- TitleBar -->
            <RowDefinition Height="*" />  <!-- Content -->
            <RowDefinition Height="Auto" /> <!-- Player Bar -->
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{StaticResource AccentRedBrush}" />
                <TextBlock Text="YT Music" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- Main content: NavigationView + Lyrics SplitView -->
        <SplitView x:Name="LyricsSplitView"
                   Grid.Row="1"
                   IsPaneOpen="{x:Bind ViewModel.IsLyricsPanelOpen, Mode=TwoWay}"
                   PanePlacement="Right"
                   OpenPaneLength="380"
                   DisplayMode="Inline"
                   PaneBackground="Transparent">

            <!-- Lyrics Pane -->
            <SplitView.Pane>
                <controls:LyricsPanel x:Name="LyricsPanelControl" />
            </SplitView.Pane>

            <!-- NavigationView Content -->
            <SplitView.Content>
                <NavigationView x:Name="NavView"
                                IsBackButtonVisible="Collapsed"
                                IsSettingsVisible="False"
                                PaneDisplayMode="Left"
                                IsPaneToggleButtonVisible="True"
                                SelectionChanged="NavView_SelectionChanged"
                                Loaded="NavView_Loaded">

                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="Home" Tag="home" Icon="Home" />
                        <NavigationViewItem Content="Explore" Tag="explore">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xF6FA;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Library" Tag="library" Icon="Library" />
                    </NavigationView.MenuItems>

                    <NavigationView.FooterMenuItems>
                        <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
                    </NavigationView.FooterMenuItems>

                    <Frame x:Name="ContentFrame" />
                </NavigationView>
            </SplitView.Content>
        </SplitView>

        <!-- Bottom Player Bar -->
        <controls:PlayerBar x:Name="PlayerBarControl" Grid.Row="2" />
    </Grid>
</Window>
