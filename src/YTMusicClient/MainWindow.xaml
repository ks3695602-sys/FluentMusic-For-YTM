<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YTMusicClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YTMusicClient.Controls"
    Title="YT Music">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" /> <!-- TitleBar -->
            <RowDefinition Height="*" />  <!-- Content -->
            <RowDefinition Height="Auto" /> <!-- Player Bar -->
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Logo & Title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentRedBrush}">
                    <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                </Border>
                <TextBlock Text="FluentMusic" Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>

            <!-- Drag Region -->
            <Grid Grid.Column="1" Background="Transparent" />

            <!-- Top-Right Actions (macOS / Liquid Glass style beside caption buttons) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,140,0">
                <Button x:Name="TopSettingsButton"
                        Width="34" Height="34" Padding="0"
                        CornerRadius="17"
                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="Settings"
                        Click="TopSettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button x:Name="UserProfileButton"
                        Width="34" Height="34" Padding="0"
                        CornerRadius="17"
                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="Google Account &amp; Sync"
                        Click="UserProfileButton_Click">
                    <FontIcon Glyph="&#xE77B;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main content: NavigationView + Lyrics SplitView -->
        <SplitView x:Name="LyricsSplitView"
                   Grid.Row="1"
                   IsPaneOpen="{x:Bind ViewModel.IsLyricsPanelOpen, Mode=TwoWay}"
                   PanePlacement="Right"
                   OpenPaneLength="380"
                   DisplayMode="Inline"
                   PaneBackground="Transparent">

            <!-- Lyrics Pane -->
            <SplitView.Pane>
                <controls:LyricsPanel x:Name="LyricsPanelControl" />
            </SplitView.Pane>

            <!-- NavigationView Content -->
            <SplitView.Content>
                <NavigationView x:Name="NavView"
                                IsBackButtonVisible="Collapsed"
                                IsSettingsVisible="False"
                                PaneDisplayMode="Left"
                                IsPaneToggleButtonVisible="True"
                                SelectionChanged="NavView_SelectionChanged"
                                Loaded="NavView_Loaded">

                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="Home" Tag="home" Icon="Home" />
                        <NavigationViewItem Content="Explore" Tag="explore">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xF6FA;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Library" Tag="library" Icon="Library" />
                    </NavigationView.MenuItems>

                    <Frame x:Name="ContentFrame" />
                </NavigationView>
            </SplitView.Content>
        </SplitView>

        <!-- Bottom Player Bar -->
        <controls:PlayerBar x:Name="PlayerBarControl" Grid.Row="2" />
    </Grid>
</Window>
