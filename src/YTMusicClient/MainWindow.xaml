<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YTMusicClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YTMusicClient.Controls"
    xmlns:models="using:YTMusicClient.Models"
    Title="FluentMusic">

    <!-- Browser & macOS Style Modular Nested Glass Panels -->
    <Grid Padding="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" /> <!-- Panel 1: Frosted Translucent Sidebar -->
            <ColumnDefinition Width="10" />  <!-- Panel Gap -->
            <ColumnDefinition Width="*" />   <!-- Panel 2: Floating Content Stage -->
        </Grid.ColumnDefinitions>

        <!-- PANEL 1: Left Translucent Liquid Glass Sidebar (Mica Alt + Wallpaper Bleed) -->
        <Border Grid.Column="0"
                Background="#18FFFFFF"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid Padding="12,14,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- App Branding & Drag Region -->
                    <RowDefinition Height="*" />    <!-- Navigation Items -->
                    <RowDefinition Height="Auto" /> <!-- Bottom User Profile / Settings -->
                </Grid.RowDefinitions>

                <!-- App Branding & Window Drag Handle -->
                <Grid x:Name="SidebarDragArea" Grid.Row="0" Margin="4,2,0,16" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentRedBrush}">
                            <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Border>
                        <TextBlock Text="FluentMusic" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" FontWeight="Bold" FontSize="14" />
                    </StackPanel>
                </Grid>

                <!-- Scrollable Navigation Items with Apple Coral-Red (#FA2D48) Icons -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="4">
                        <!-- Main Navigation -->
                        <Button x:Name="NavSearchBtn"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0" CornerRadius="10" Padding="12,8"
                                Click="NavSearchBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Search" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavHomeBtn"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,8"
                                Click="NavHomeBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE80F;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Home" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavExploreBtn"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,8"
                                Click="NavExploreBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xF6FA;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Explore / New" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Section: Library -->
                        <TextBlock Text="LIBRARY"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="10.5" FontWeight="Bold" Margin="12,16,0,4" />

                        <Button x:Name="NavLibraryBtn"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,7"
                                Click="NavLibraryBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Recently Added" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,7"
                                Click="NavLibraryBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE77B;" FontSize="13" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Artists" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,7"
                                Click="NavLibraryBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE93C;" FontSize="13" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Albums" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,7"
                                Click="NavLibraryBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Songs" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Section: Playlists -->
                        <TextBlock Text="PLAYLISTS"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="10.5" FontWeight="Bold" Margin="12,16,0,4" />

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,7"
                                Click="NavLibraryBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xEB51;" FontSize="13" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Favorite Songs" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,7"
                                Click="NavSearchBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE90B;" FontSize="13" Foreground="{StaticResource AccentRedBrush}" />
                                <TextBlock Text="Top Hits 2026" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom User Profile Card (Clicking opens Settings / Sync) -->
                <Border Grid.Row="2" Margin="0,8,0,0" Padding="8"
                        Background="#20FFFFFF"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="10"
                        Cursor="Hand"
                        PointerPressed="UserProfile_PointerPressed">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="#353842">
                            <TextBlock Text="FM" FontWeight="Bold" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Fluent User" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Free Listening" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
                        </StackPanel>
                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="4"
                                Click="SettingsShortcut_Click">
                            <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- PANEL 2: Main Content Stage + Right Drawer + Floating Liquid Glass Player -->
        <Border Grid.Column="2"
                Background="#14161C"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <!-- SplitView for Slide-Out Right Drawer (Up Next / Lyrics / History) -->
                <SplitView x:Name="RightDrawerSplitView"
                           DisplayMode="Overlay"
                           PanePlacement="Right"
                           OpenPaneLength="380"
                           IsPaneOpen="False">

                    <!-- Drawer Pane: Liquid Glass Tabbed Panel -->
                    <SplitView.Pane>
                        <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="1,0,0,0"
                                Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Tab Selector + Close -->
                                    <RowDefinition Height="*" />    <!-- Content View -->
                                </Grid.RowDefinitions>

                                <!-- Top Drawer Header: Segmented Tabs & Close Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Segmented Switcher [ Up Next | Lyrics | History ] -->
                                    <Border Background="#25FFFFFF" BorderBrush="{StaticResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="2">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="TabUpNextBtn" Content="Up Next"
                                                    Click="TabUpNextBtn_Click"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderThickness="0" CornerRadius="10" Padding="10,4"
                                                    FontSize="11" FontWeight="SemiBold" />
                                            <Button x:Name="TabLyricsBtn" Content="Lyrics"
                                                    Click="TabLyricsBtn_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0" CornerRadius="10" Padding="10,4"
                                                    FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="TabHistoryBtn" Content="History"
                                                    Click="TabHistoryBtn_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0" CornerRadius="10" Padding="10,4"
                                                    FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Close Drawer Button -->
                                    <Button Grid.Column="1" Click="CloseDrawerBtn_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Width="30" Height="30" CornerRadius="15" Padding="0">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                    </Button>
                                </Grid>

                                <!-- Drawer Body Views -->
                                <Grid Grid.Row="1">
                                    <!-- 1. Up Next Queue View -->
                                    <Grid x:Name="UpNextView">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="UP NEXT" FontSize="11" FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="Clear All" Click="ClearQueue_Click"
                                                    HorizontalAlignment="Right" Background="Transparent"
                                                    BorderThickness="0" FontSize="11" Foreground="{StaticResource AccentRedBrush}" />
                                        </Grid>
                                        <ListView Grid.Row="1"
                                                  ItemsSource="{x:Bind ViewModel.PlaybackService.UpNext, Mode=OneWay}"
                                                  SelectionMode="None"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="QueueItem_Click">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:Song">
                                                    <Grid Padding="4,8" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border CornerRadius="4" Width="34" Height="34">
                                                            <Image Stretch="UniformToFill">
                                                                <Image.Source>
                                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                                 DecodePixelWidth="34" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12"
                                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       FontSize="10" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Click="RemoveQueueItem_Click" Tag="{x:Bind}"
                                                                Background="Transparent" BorderThickness="0" Padding="4">
                                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>

                                    <!-- 2. Lyrics View -->
                                    <Grid x:Name="LyricsView" Visibility="Collapsed">
                                        <controls:LyricsPanel x:Name="EmbeddedLyricsPanel" />
                                    </Grid>

                                    <!-- 3. History View -->
                                    <Grid x:Name="HistoryView" Visibility="Collapsed">
                                        <ListView ItemsSource="{x:Bind ViewModel.PlaybackService.History, Mode=OneWay}"
                                                  SelectionMode="None"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="QueueItem_Click">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:Song">
                                                    <Grid Padding="4,8" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border CornerRadius="4" Width="34" Height="34">
                                                            <Image Stretch="UniformToFill">
                                                                <Image.Source>
                                                                    <BitmapImage UriSource="{x:Bind ThumbnailUrl, Converter={StaticResource StringToUriConverter}}"
                                                                                 DecodePixelWidth="34" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12"
                                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       FontSize="10" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </SplitView.Pane>

                    <!-- SplitView Main Content: Page Frame -->
                    <SplitView.Content>
                        <Frame x:Name="ContentFrame" />
                    </SplitView.Content>
                </SplitView>

                <!-- Floating Liquid Glass Player Capsule (Layer 1: Hovers centered above content!) -->
                <controls:PlayerBar x:Name="PlayerBarControl"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,20" />
            </Grid>
        </Border>
    </Grid>
</Window>
