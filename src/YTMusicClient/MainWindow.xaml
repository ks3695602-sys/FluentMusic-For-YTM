<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YTMusicClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YTMusicClient.Controls"
    Title="FluentMusic">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" /> <!-- Custom Unified TitleBar -->
            <RowDefinition Height="*" />  <!-- Main App Body -->
        </Grid.RowDefinitions>

        <!-- Custom Unified TitleBar -->
        <Grid Grid.Row="0" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- App Branding aligns with sidebar -->
                <ColumnDefinition Width="*" />   <!-- Center Draggable Region ONLY -->
                <ColumnDefinition Width="Auto" /> <!-- Top-Right Actions -->
            </Grid.ColumnDefinitions>

            <!-- App Logo & Title (Left aligned) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentRedBrush}">
                    <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                </Border>
                <TextBlock Text="FluentMusic" Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" FontWeight="Bold" FontSize="14" />
            </StackPanel>

            <!-- ONLY DragRegion is passed to SetTitleBar so buttons remain clickable! -->
            <Grid x:Name="DragRegion" Grid.Column="1" Background="Transparent" />

            <!-- Top-Right Actions (Interactive buttons outside the draggable region) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="0,0,140,0">
                <Button x:Name="TopSettingsButton"
                        Width="32" Height="32" Padding="0"
                        CornerRadius="16"
                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="Settings"
                        Click="TopSettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="13" />
                </Button>
                <Button x:Name="UserProfileButton"
                        Width="32" Height="32" Padding="0"
                        CornerRadius="16"
                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="Account / Settings"
                        Click="UserProfileButton_Click">
                    <FontIcon Glyph="&#xE77B;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body: Left Sidebar + Right Content Area with Floating Player -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- macOS Left Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Content Area with Floating Overlay -->
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar (macOS Apple Music Style) -->
            <Border Grid.Column="0"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Padding="12,12,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <!-- Main Navigation -->
                            <Button x:Name="NavSearchBtn"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,8"
                                    Click="NavSearchBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                                    <TextBlock Text="Search" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavHomeBtn"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,8"
                                    Click="NavHomeBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE80F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Home" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavExploreBtn"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,8"
                                    Click="NavExploreBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xF6FA;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Explore / New" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <!-- Section Header: Library -->
                            <TextBlock Text="LIBRARY"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       FontSize="11" FontWeight="Bold" Margin="12,16,0,4" />

                            <Button x:Name="NavLibraryBtn"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,7"
                                    Click="NavLibraryBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Recently Added" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,7"
                                    Click="NavLibraryBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE77B;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Artists" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,7"
                                    Click="NavLibraryBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE93C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Albums" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,7"
                                    Click="NavLibraryBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Songs" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <!-- Section Header: Playlists -->
                            <TextBlock Text="PLAYLISTS"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       FontSize="11" FontWeight="Bold" Margin="12,16,0,4" />

                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{StaticResource AccentRedBrush}" />
                                    <TextBlock Text="Favorite Songs" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE90B;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Top Hits 2026" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom User Profile (macOS Apple Music Style) -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="#3A3D45">
                                <TextBlock Text="FM" FontWeight="Bold" FontSize="12" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Fluent User" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Free Listening" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Content Frame + Floating Acrylic Player Overlay -->
            <Grid Grid.Column="1">
                <!-- Content Frame (Layer 0: content scrolls all the way to bottom!) -->
                <Frame x:Name="ContentFrame" />

                <!-- Floating Liquid Glass Player Bar (Layer 1: Hovers centered above content!) -->
                <controls:PlayerBar x:Name="PlayerBarControl"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,22" />
            </Grid>
        </Grid>
    </Grid>
</Window>
