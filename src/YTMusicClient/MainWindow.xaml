<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YTMusicClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YTMusicClient.Controls"
    Title="FluentMusic">

    <!-- Zero-Gap Full-Window Canvas with Dynamic Mica Alt / Acrylic Backdrop -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- 1. Apple-Style Sidebar -->
            <ColumnDefinition x:Name="SidebarColDef" Width="220" />
            <!-- 2. Zero-Gap Main Content Stage -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Flush Edge-to-Edge Pane -->
        <Border x:Name="SidebarPane"
                Grid.Column="0"
                Background="{ThemeResource SidebarMicaBrush}"
                BorderBrush="{ThemeResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="0">
            <Grid Padding="8,6,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Top Header with Toggle Button -->
                    <RowDefinition Height="Auto" /> <!-- Navigation Category Items -->
                    <RowDefinition Height="*" />    <!-- Empty Middle Spacer (Designated Drag Area) -->
                    <RowDefinition Height="Auto" /> <!-- Bottom User Account & Settings -->
                </Grid.RowDefinitions>

                <!-- Top Header with Apple Sidebar Toggle [| ] & App Title -->
                <Grid Grid.Row="0" Height="44" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Apple Notes/Safari Style Sidebar Toggle Icon [| ] -->
                    <Button x:Name="SidebarToggleBtn" Click="SidebarToggleBtn_Click"
                            Grid.Column="0"
                            Width="32" Height="30" Padding="0"
                            Margin="4,0,0,0"
                            Background="Transparent" BorderThickness="0" CornerRadius="8"
                            ToolTipService.ToolTip="Hide Sidebar">
                        <Grid Width="16" Height="13">
                            <Border BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                    BorderThickness="1.5" CornerRadius="3" />
                            <Border Width="1.5" HorizontalAlignment="Left" Margin="4.5,0,0,0"
                                    Background="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>

                    <!-- Clean FluentMusic Brand Typography -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FluentMusic" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" CharacterSpacing="-15" />
                    </StackPanel>
                </Grid>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
                    <!-- Home -->
                    <Button x:Name="NavHomeBtn" Click="NavHome_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderThickness="1" BorderBrush="Transparent" CornerRadius="12" Padding="12,9">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{StaticResource AccentRedBrush}" />
                            <TextBlock x:Name="NavHomeText" Text="Home" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Explore -->
                    <Button x:Name="NavExploreBtn" Click="NavExplore_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12" Padding="12,9">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xF6FA;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="NavExploreText" Text="Explore" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Library with Expandable Downloads Sub-item -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="NavLibraryBtn" Click="NavLibrary_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12" Padding="12,9">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="NavLibraryText" Text="Library" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavLibraryChevronBtn" Click="NavLibraryChevron_Click"
                                Grid.Column="1" Background="Transparent" BorderThickness="0"
                                CornerRadius="8" Width="30" Height="34" Padding="0" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Toggle Downloads Tab">
                            <FontIcon x:Name="NavLibraryChevron" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Downloads Sub-Item (Revealed by Arrow) -->
                    <Button x:Name="NavDownloadsBtn" Click="NavDownloads_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" CornerRadius="10"
                            Padding="26,8,12,8" Margin="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="NavDownloadsText" Text="Downloads" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Designated Window Drag Area: Empty Middle Section of Sidebar -->
                <Grid x:Name="SidebarMidDragArea" Grid.Row="2" Background="Transparent" />

                <!-- Bottom Account & Settings Section -->
                <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,4">
                    <!-- User Profile / Google Account Sync Pill -->
                    <Border x:Name="UserAccountPill" CornerRadius="18"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="8,6"
                            PointerPressed="UserAccountPill_PointerPressed"
                            ToolTipService.ToolTip="Google Account &amp; Settings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                <Grid>
                                    <FontIcon x:Name="UserAccountAvatarIcon" Glyph="&#xE77B;" FontSize="12" Foreground="{StaticResource AccentRedBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="UserAccountAvatarImage" Width="24" Height="24" Stretch="UniformToFill" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="UserAccountStatusTitle" Text="Google Sync" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="UserAccountStatusSub" Text="Sign in to sync" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,4,0" />
                        </Grid>
                    </Border>

                    <!-- Settings Button -->
                    <Button x:Name="NavSettingsBtn" Click="NavSettings_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="NavSettingsText" Text="Settings" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Stage (Zero-Gap Full Screen) -->
        <Grid Grid.Column="1" Background="{ThemeResource MainStageMatteBrush}">
            <!-- Far-left hover trigger strip for sidebar peek when collapsed -->
            <Border x:Name="SidebarPeekTrigger"
                    HorizontalAlignment="Left"
                    Width="12"
                    Background="Transparent"
                    Visibility="Collapsed"
                    Canvas.ZIndex="99"
                    PointerEntered="SidebarPeekTrigger_PointerEntered" />

            <!-- Sidebar Reveal Button when collapsed (Floating Top Left) -->
            <Button x:Name="CollapsedSidebarRevealBtn" Click="SidebarToggleBtn_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="32" Height="30" Padding="0"
                    Margin="12,8,0,0"
                    Canvas.ZIndex="100"
                    Visibility="Collapsed"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0" CornerRadius="6"
                    ToolTipService.ToolTip="Show Sidebar">
                <Grid Width="16" Height="13">
                    <Border BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                            BorderThickness="1.5" CornerRadius="3" />
                    <Border Width="1.5" HorizontalAlignment="Left" Margin="4.5,0,0,0"
                            Background="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <!-- Minimal Windows Caption Controls (Auto-hiding on Hover, Floating Top Right) -->
            <Border x:Name="CaptionControlsBorder"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Canvas.ZIndex="100"
                    Opacity="0"
                    Background="Transparent"
                    PointerEntered="CaptionControls_PointerEntered"
                    PointerExited="CaptionControls_PointerExited">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="WinMinimizeBtn" Click="WinMinimizeBtn_Click"
                            Width="46" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="0"
                            ToolTipService.ToolTip="Minimize">
                        <FontIcon Glyph="&#xE921;" FontSize="10" />
                    </Button>
                    <Button x:Name="WinMaximizeBtn" Click="WinMaximizeBtn_Click"
                            Width="46" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="0"
                            ToolTipService.ToolTip="Maximize">
                        <FontIcon x:Name="WinMaximizeGlyph" Glyph="&#xE922;" FontSize="10" />
                    </Button>
                    <Button x:Name="WinCloseBtn" Click="WinCloseBtn_Click"
                            Width="46" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="0"
                            ToolTipService.ToolTip="Close">
                        <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- SplitView for Spotify-Style Now Playing Right Sidebar & Lyrics Drawer -->
            <SplitView x:Name="LyricsSplitView"
                       IsPaneOpen="{x:Bind ViewModel.IsLyricsPanelOpen, Mode=TwoWay}"
                       PanePlacement="Right"
                       OpenPaneLength="380"
                       DisplayMode="Overlay"
                       PaneBackground="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">

                    <!-- Spotify-Style Right Sidebar Pane -->
                    <SplitView.Pane>
                        <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Top Header with Tabs & Popout Button -->
                                    <RowDefinition Height="*" />    <!-- Content Stage: Now Playing View OR Lyrics Panel -->
                                </Grid.RowDefinitions>

                                <!-- Top Header Capsule -->
                                <Grid Grid.Row="0" Padding="14,12,12,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Dual View Segmented Pill: Now Playing vs Lyrics -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="14" Padding="2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="SidebarTabNowPlayingBtn" Click="SidebarTab_Click" Tag="nowplaying"
                                                    CornerRadius="12" Padding="10,4" FontSize="11" FontWeight="SemiBold"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{StaticResource AccentRedBrush}" />
                                                    <TextBlock Text="Now Playing" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="SidebarTabLyricsBtn" Click="SidebarTab_Click" Tag="lyrics"
                                                    CornerRadius="12" Padding="10,4" FontSize="11" FontWeight="Normal"
                                                    Background="Transparent" BorderThickness="0">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE8D6;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="Lyrics" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right Actions: Float Overlay (Pop-out 🗗) + Close (✕) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="SidebarPopoutBtn" Click="SidebarPopout_Click"
                                                Width="28" Height="28" CornerRadius="14" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Float as Mini Player Overlay">
                                            <FontIcon Glyph="&#xE7B7;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                        <Button x:Name="SidebarCloseBtn" Click="SidebarClose_Click"
                                                Width="28" Height="28" CornerRadius="14" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Close Sidebar">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- 1. Spotify-Style Now Playing Mini Card View -->
                                <ScrollViewer x:Name="SidebarNowPlayingView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14">
                                    <StackPanel Spacing="14">
                                        <!-- Large Rounded Album Art Card -->
                                        <Border CornerRadius="16" Width="260" Height="260" HorizontalAlignment="Center"
                                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                            <Image x:Name="SidebarAlbumImage" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Song Info & Like Button -->
                                        <Grid Margin="4,2,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.PlayerBar.Title, Mode=OneWay}"
                                                           FontSize="15" FontWeight="Bold" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.PlayerBar.Artist, Mode=OneWay}"
                                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Width="34" Height="34" CornerRadius="17" Padding="0"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0">
                                                <FontIcon Glyph="&#xE734;" FontSize="12.5" Foreground="{StaticResource AccentRedBrush}" />
                                            </Button>
                                        </Grid>

                                        <!-- Fidelity Badge -->
                                        <Border Background="#20FA2D48" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" Margin="4,0">
                                            <TextBlock Text="∿ Hi-Res Lossless • Studio Master" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}" />
                                        </Border>

                                        <!-- "About the artist" Spotify Card -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="14" Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="About the artist" FontSize="12" FontWeight="Bold" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                        <Image x:Name="SidebarArtistImage" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="{x:Bind ViewModel.PlayerBar.Artist, Mode=OneWay}" FontWeight="SemiBold" FontSize="11.5" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="Verified Artist • Top Mix" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Follow" FontSize="10" FontWeight="SemiBold"
                                                            Padding="10,4" CornerRadius="12" Background="{StaticResource AppleAccentGradient}"
                                                            Foreground="White" BorderThickness="0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Next in Queue Preview Card -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="14" Padding="12">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <TextBlock Text="Next in queue" FontSize="12" FontWeight="Bold" />
                                                    <Button Content="View all" HorizontalAlignment="Right" Click="QueueOpen_Click"
                                                            FontSize="10" Foreground="{StaticResource AccentRedBrush}" Background="Transparent" BorderThickness="0" Padding="0" />
                                                </Grid>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,6">
                                                    <StackPanel>
                                                        <TextBlock x:Name="SidebarNextTitle" Text="Auto Radio Mix"
                                                                   FontSize="11" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="SidebarNextArtist" Text="Based on your listening taste"
                                                                   FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Expand to Fullscreen Stage Button -->
                                        <Button Click="NowPlaying_Click" HorizontalAlignment="Stretch"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="12" Padding="10,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                <FontIcon Glyph="&#xE740;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                                                <TextBlock Text="Open Full Stage" FontWeight="SemiBold" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 2. Pure SpicyLyrics View -->
                                <Grid x:Name="SidebarLyricsView" Grid.Row="1" Visibility="Collapsed">
                                    <controls:LyricsPanel x:Name="LyricsPanelControl" />
                                </Grid>
                            </Grid>
                        </Border>
                    </SplitView.Pane>

                    <!-- SplitView Main Content: Page Stage + Floating Capsule Player -->
                    <SplitView.Content>
                        <Grid>
                            <!-- Navigation Content Frame (Zero Gap, Edge to Edge) -->
                            <Frame x:Name="ContentFrame" />

                            <!-- Full Stage Apple Music "Now Playing" Experience -->
                            <Grid x:Name="NowPlayingOverlay"
                                  RequestedTheme="Dark"
                                  Visibility="Collapsed"
                                  Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
                                    <RowDefinition Height="*" />    <!-- Apple 2-Column Split: Artwork & Controls | Syllable Lyrics -->
                                </Grid.RowDefinitions>

                                <!-- Live Mesh Gradient Background Layer with Gaussian Blur (Edge-to-Edge) -->
                                <Grid x:Name="NpMeshBackground" Grid.RowSpan="2" IsHitTestVisible="False">
                                    <Rectangle Fill="#0A0A0E" />
                                    <!-- Gradient Mesh Spot 1 (Top Left Ambient Glow) -->
                                    <Ellipse x:Name="NpMeshEllipse1" Width="700" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-150,0,0" Opacity="0.55">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                <GradientStop x:Name="NpMeshStop1" Color="#80FA2D48" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Gradient Mesh Spot 2 (Bottom Right Ambient Glow) -->
                                    <Ellipse x:Name="NpMeshEllipse2" Width="800" Height="800" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-200" Opacity="0.45">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                <GradientStop x:Name="NpMeshStop2" Color="#803B82F6" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>

                                <!-- Top Header Bar: Back to Browse Button + Stage View Toggle Capsule -->
                                <Grid Grid.Row="0" Padding="28,14,28,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Apple "Browse" Back Button with Chevron -->
                                    <Button x:Name="NpBackButton" Click="NpBackButton_Click"
                                            CornerRadius="14" Padding="12,6"
                                            Background="#25FFFFFF" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72B;" FontSize="11" Foreground="White" />
                                            <TextBlock Text="Browse" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Center Stage Mode Toggle Capsule [ Song & Lyrics | Music Video ] -->
                                    <Border Grid.Column="1" HorizontalAlignment="Center"
                                            Background="#33000000" CornerRadius="16" Padding="3"
                                            BorderBrush="#25FFFFFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="NpStageSongBtn" Click="NpStageSong_Click"
                                                    CornerRadius="13" Padding="12,5"
                                                    Background="#40FFFFFF" BorderThickness="0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="{StaticResource AccentRedBrush}" />
                                                    <TextBlock Text="Song &amp; Lyrics" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="NpStageVideoBtn" Click="NpStageVideo_Click"
                                                    CornerRadius="13" Padding="12,5"
                                                    Background="Transparent" BorderThickness="0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE714;" FontSize="11" Foreground="#B0B0B0" />
                                                    <TextBlock Text="Music Video" FontSize="11" FontWeight="Normal" Foreground="#B0B0B0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 1. Song Stage: Apple Music 2-Column Split View -->
                                <Grid x:Name="NpSongStage" Grid.Row="1" Padding="32,6,32,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" MaxWidth="440" />
                                        <ColumnDefinition Width="6*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT COLUMN: Artwork (Responsive) + Metadata + Scrubber + Transport Controls -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="12" Margin="0,0,16,0">
                                        <!-- Large High-Res Artwork with Apple Rounded Corners -->
                                        <Border CornerRadius="16"
                                                MaxWidth="280" MaxHeight="280"
                                                HorizontalAlignment="Center"
                                                BorderBrush="#25FFFFFF" BorderThickness="1">
                                            <Image x:Name="NpAlbumImage" Stretch="Uniform"
                                                   MaxWidth="280" MaxHeight="280">
                                                <Image.Source>
                                                    <BitmapImage x:Name="NpAlbumBitmap"
                                                                 DecodePixelWidth="280"
                                                                 DecodePixelHeight="280" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <!-- Track Title & Artist Info + Action Buttons -->
                                        <Grid Margin="4,2,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="NpTitleText" Text="Not Playing"
                                                           FontWeight="Bold" FontSize="18"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                <TextBlock x:Name="NpArtistText" Text="Choose a song to start listening"
                                                           FontSize="13.5" Foreground="#B0B0B0"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Width="34" Height="34" CornerRadius="17" Padding="0" Background="#20FFFFFF" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="#E0E0E0" />
                                                </Button>
                                                <Button Width="34" Height="34" CornerRadius="17" Padding="0" Background="#20FFFFFF" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="#E0E0E0" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Scrubber: Elapsed Time - Lossless Pill - Remaining Time -->
                                        <StackPanel Margin="4,0,4,0" Spacing="2">
                                            <Slider x:Name="NpPositionSlider"
                                                    Minimum="0" Maximum="100" Value="0"
                                                    Margin="0,-6"
                                                    ValueChanged="NpPositionSlider_ValueChanged" />
                                            <Grid>
                                                <TextBlock x:Name="NpPositionText" Text="0:00" FontSize="10.5" Foreground="#B0B0B0" HorizontalAlignment="Left" />
                                                <Border Background="#20FA2D48" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="NpFidelityText" Text="∿ Hi-Res Lossless" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}" />
                                                </Border>
                                                <TextBlock x:Name="NpDurationText" Text="0:00" FontSize="10.5" Foreground="#B0B0B0" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Transport Controls Row (Matching Apple Music layout) -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18" Margin="0,2,0,0">
                                            <Button Click="PlayerShuffle_Click" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0">
                                                <FontIcon Glyph="&#xE8B1;" FontSize="13" Foreground="#B0B0B0" />
                                            </Button>
                                            <Button Click="PlayerPrev_Click" Width="40" Height="40" CornerRadius="20" Background="Transparent" BorderThickness="0">
                                                <FontIcon Glyph="&#xE892;" FontSize="16" Foreground="White" />
                                            </Button>
                                            <Button Click="PlayerPlayPause_Click" Width="50" Height="50" CornerRadius="25" Background="#FA2D48" BorderThickness="0">
                                                <FontIcon x:Name="NpPlayPauseIcon" Glyph="&#xE768;" FontSize="18" Foreground="White" Margin="2,0,0,0" />
                                            </Button>
                                            <Button Click="PlayerNext_Click" Width="40" Height="40" CornerRadius="20" Background="Transparent" BorderThickness="0">
                                                <FontIcon Glyph="&#xE893;" FontSize="16" Foreground="White" />
                                            </Button>
                                            <Button Click="PlayerRepeat_Click" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0">
                                                <FontIcon Glyph="&#xE8EE;" FontSize="13" Foreground="#B0B0B0" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- RIGHT COLUMN: Syllable Lyrics Suite (Spicy Lyrics) -->
                                    <Border Grid.Column="1" Margin="20,0,0,0"
                                            Background="Transparent" CornerRadius="20"
                                            BorderThickness="0"
                                            Padding="4">
                                        <controls:LyricsPanel x:Name="NowPlayingLyricsPanel" />
                                    </Border>
                                </Grid>

                                <!-- 2. Music Video Stage (Embedded High-Res YouTube Player in WebView2) -->
                                <Grid x:Name="NpVideoStage" Grid.Row="1" Visibility="Collapsed" Padding="20,10,20,90">
                                    <Border CornerRadius="14"
                                            BorderBrush="#25FFFFFF" BorderThickness="1"
                                            Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <WebView2 x:Name="NpVideoWebView"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Floating Liquid Glass Player Capsule (Apple Music macOS HIG) -->
                            <Grid x:Name="FloatingPlayerContainer"
                                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                  Margin="0,0,0,12" Canvas.ZIndex="80">
                                <controls:PlayerBar x:Name="PlayerBarControl" />
                            </Grid>

                            <!-- Floating Acrylic Pop-Out Mini Player (Interactive Overlay Card) -->
                            <Border x:Name="FloatingMiniPlayerOverlay"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,24,72" Canvas.ZIndex="120"
                                    Width="300"
                                    CornerRadius="18"
                                    Background="{StaticResource PillAcrylicBrush}"
                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed"
                                    PointerEntered="FloatingMiniPlayer_PointerEntered"
                                    PointerExited="FloatingMiniPlayer_PointerExited">
                                <Grid Padding="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Cover + Info + Re-dock Button -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border CornerRadius="8" Width="44" Height="44" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                            <Image x:Name="FloatingAlbumImage" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                            <TextBlock Text="{x:Bind ViewModel.PlayerBar.Title, Mode=OneWay}"
                                                       FontSize="12" FontWeight="Bold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.PlayerBar.Artist, Mode=OneWay}"
                                                       FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Re-dock to Sidebar (🗖) + Close (✕) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                            <Button Click="FloatingDockToSidebar_Click" Width="26" Height="26" CornerRadius="13" Padding="0"
                                                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Dock Back to Sidebar">
                                                <FontIcon Glyph="&#xE740;" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Button>
                                            <Button Click="FloatingClose_Click" Width="26" Height="26" CornerRadius="13" Padding="0"
                                                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Close">
                                                <FontIcon Glyph="&#xE711;" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Row: Transport Controls (revealed on hover) -->
                                    <Grid x:Name="FloatingTransportRow" Grid.Row="1" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                            <Button Click="PlayerPrev_Click" Width="30" Height="30" CornerRadius="15" Padding="0" Background="Transparent" BorderThickness="0">
                                                <FontIcon Glyph="&#xE892;" FontSize="11" />
                                            </Button>
                                            <Button Click="PlayerPlayPause_Click" Width="32" Height="32" CornerRadius="16" Padding="0" Background="#FA2D48" BorderThickness="0">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White" />
                                            </Button>
                                            <Button Click="PlayerNext_Click" Width="30" Height="30" CornerRadius="15" Padding="0" Background="Transparent" BorderThickness="0">
                                                <FontIcon Glyph="&#xE893;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </SplitView.Content>
                </SplitView>
            </Grid>
    </Grid>
</Window>