<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTMusicClient.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Floating Capsule Player Bar (macOS / Liquid Glass aesthetic) -->
    <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="26"
            Margin="20,0,20,16"
            Padding="16,8"
            MinHeight="72"
            VerticalAlignment="Bottom">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" /> <!-- Song info -->
                <ColumnDefinition Width="*" />   <!-- Playback controls -->
                <ColumnDefinition Width="220" /> <!-- Actions & Volume -->
            </Grid.ColumnDefinitions>

            <!-- Left: Song Info (Thumbnail + Titles) -->
            <Grid ColumnSpacing="12"
                  VerticalAlignment="Center"
                  Visibility="{x:Bind ViewModel.HasSong, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="8" Width="48" Height="48">
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage UriSource="{x:Bind ViewModel.ThumbnailUrl, Mode=OneWay, Converter={StaticResource StringToUriConverter}}"
                                         DecodePixelWidth="48" />
                        </Image.Source>
                    </Image>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               MaxLines="1" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               FontSize="13" />
                    <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                               MaxLines="1" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Center: Playback Transport & Scrubber -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <Button Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="16" IsEnabled="False">
                        <FontIcon Glyph="&#xE892;" FontSize="14" /> <!-- Previous -->
                    </Button>

                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                            Width="38" Height="38" CornerRadius="19"
                            Padding="0">
                        <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseGlyph}}"
                                  FontSize="16" />
                    </Button>

                    <Button Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="16" IsEnabled="False">
                        <FontIcon Glyph="&#xE893;" FontSize="14" /> <!-- Next -->
                    </Button>
                </StackPanel>

                <!-- Scrubber Slider -->
                <Grid ColumnSpacing="8" HorizontalAlignment="Center" Width="440">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Bind ViewModel.Position, Mode=OneWay, Converter={StaticResource TimeSpanConverter}}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />

                    <Slider Grid.Column="1" Minimum="0" Maximum="100"
                            Value="{x:Bind ViewModel.ProgressPercent, Mode=TwoWay}"
                            Margin="0,-6" />

                    <TextBlock Grid.Column="2"
                               Text="{x:Bind ViewModel.Duration, Mode=OneWay, Converter={StaticResource TimeSpanConverter}}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Right: Volume & Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="10">
                <Button Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="14"
                        Command="{x:Bind ViewModel.ToggleMuteCommand}"
                        ToolTipService.ToolTip="Mute / Unmute">
                    <FontIcon Glyph="&#xE767;" FontSize="15" />
                </Button>

                <Slider Minimum="0" Maximum="1"
                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                        StepFrequency="0.01" Width="90" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
