<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTMusicClient.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:YTMusicClient.Converters">

    <UserControl.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToGlyphConverter x:Key="PlayPauseGlyph" TrueGlyph="&#xE769;" FalseGlyph="&#xE768;" />
        <converters:StringToUriConverter x:Key="StringToUriConverter" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0"
          Padding="16,8" MinHeight="80">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" /> <!-- Song info -->
            <ColumnDefinition Width="*" />   <!-- Playback controls -->
            <ColumnDefinition Width="220" /> <!-- Volume & Extras -->
        </Grid.ColumnDefinitions>

        <!-- Song Info -->
        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasSong, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="6" Width="56" Height="56">
                <Image Stretch="UniformToFill">
                    <Image.Source>
                        <BitmapImage UriSource="{x:Bind ViewModel.ThumbnailUrl, Mode=OneWay, Converter={StaticResource StringToUriConverter}}"
                                     DecodePixelWidth="56" />
                    </Image.Source>
                </Image>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}" MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Playback Controls -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <!-- Previous Track -->
                <Button Background="Transparent" BorderThickness="0"
                        Command="{x:Bind ViewModel.PreviousTrackCommand}"
                        ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>

                <!-- Play / Pause -->
                <Button Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                        Width="40" Height="40" CornerRadius="20"
                        Padding="0"
                        ToolTipService.ToolTip="Play / Pause">
                    <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseGlyph}}"
                              FontSize="18" />
                </Button>

                <!-- Next Track -->
                <Button Background="Transparent" BorderThickness="0"
                        Command="{x:Bind ViewModel.NextTrackCommand}"
                        ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- Progress Bar -->
            <Grid ColumnSpacing="8" HorizontalAlignment="Center" Width="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind ViewModel.Position, Mode=OneWay, Converter={StaticResource TimeSpanConverter}}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />

                <Slider Grid.Column="1" Minimum="0" Maximum="100"
                        Value="{x:Bind ViewModel.ProgressPercent, Mode=TwoWay}" />

                <TextBlock Grid.Column="2"
                           Text="{x:Bind ViewModel.Duration, Mode=OneWay, Converter={StaticResource TimeSpanConverter}}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- Volume Control & Actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Spacing="6">
            <Button Background="Transparent" BorderThickness="0"
                    Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                    ToolTipService.ToolTip="Shuffle">
                <FontIcon Glyph="&#xE8B1;" FontSize="14" />
            </Button>
            <Button Background="Transparent" BorderThickness="0"
                    Command="{x:Bind ViewModel.ToggleRepeatCommand}"
                    ToolTipService.ToolTip="Repeat">
                <FontIcon Glyph="&#xE8EE;" FontSize="14" />
            </Button>
            <Button Background="Transparent" BorderThickness="0"
                    Click="LyricsButton_Click"
                    ToolTipService.ToolTip="Lyrics">
                <FontIcon Glyph="&#xE8D6;" FontSize="16" />
            </Button>
            <Button Background="Transparent" BorderThickness="0"
                    Command="{x:Bind ViewModel.ToggleMuteCommand}"
                    ToolTipService.ToolTip="Mute / Unmute">
                <FontIcon Glyph="&#xE767;" FontSize="16" />
            </Button>
            <Slider Minimum="0" Maximum="1"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                    StepFrequency="0.01" Width="70" />
        </StackPanel>
    </Grid>
</UserControl>
