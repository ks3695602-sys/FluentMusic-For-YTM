<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTMusicClient.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:YTMusicClient.Converters">

    <UserControl.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <converters:BoolToGlyphConverter x:Key="PlayPauseGlyph" TrueGlyph="&#xE769;" FalseGlyph="&#xE768;" />
        <converters:StringToUriConverter x:Key="StringToUriConverter" />
    </UserControl.Resources>

    <!-- Floating Capsule Player (Apple Music macOS Liquid Glass style) -->
    <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Width="740"
            Height="54"
            Padding="12,4"
            HorizontalAlignment="Center">

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Left: Apple Transport Controls -->
                <ColumnDefinition Width="*" />    <!-- Center: Dedicated Now-Playing LCD Box -->
                <ColumnDefinition Width="Auto" /> <!-- Right: Equalizer + Menu + Lyrics + Volume -->
            </Grid.ColumnDefinitions>

            <!-- 1. Left Transport Controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="3">
                <!-- Shuffle Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                        ToolTipService.ToolTip="Shuffle">
                    <FontIcon Glyph="&#xE8B1;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Previous Track Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        Command="{x:Bind ViewModel.PreviousTrackCommand}"
                        ToolTipService.ToolTip="Previous Track">
                    <FontIcon Glyph="&#xE892;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>

                <!-- Play / Pause Button -->
                <Button Background="{ThemeResource SubtleFillColorTransparentBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                        Width="32" Height="32" CornerRadius="16"
                        Padding="0"
                        ToolTipService.ToolTip="Play / Pause">
                    <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseGlyph}}"
                              FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>

                <!-- Next Track Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        Command="{x:Bind ViewModel.NextTrackCommand}"
                        ToolTipService.ToolTip="Next Track">
                    <FontIcon Glyph="&#xE893;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
            </StackPanel>

            <!-- 2. Center: Dedicated Now-Playing LCD Box (Click to toggle Lyrics/NowPlaying) -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,4"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    PointerPressed="CenterLcdPill_PointerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Cover + Info + Quality Badge -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Square Album Art -->
                        <Border CornerRadius="4" Width="32" Height="32" VerticalAlignment="Center">
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage UriSource="{x:Bind ViewModel.ThumbnailUrl, Mode=OneWay, Converter={StaticResource StringToUriConverter}}"
                                                 DecodePixelWidth="32" />
                                </Image.Source>
                            </Image>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0" Spacing="1">
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontSize="11" FontWeight="SemiBold"
                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                                       FontSize="9.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Audio Source & Fidelity Tier Badges -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Fidelity Tier Pill Badge (Hi-Res Lossless / Hi-Res / Basic) -->
                            <Border Background="{x:Bind ViewModel.FidelityBadgeBackground, Mode=OneWay}"
                                    CornerRadius="4" Padding="5,2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Audio Stream Fidelity Tier">
                                <TextBlock Text="{x:Bind ViewModel.FidelityBadgeText, Mode=OneWay}"
                                           FontSize="8" FontWeight="Bold"
                                           Foreground="{x:Bind ViewModel.FidelityBadgeForeground, Mode=OneWay}" />
                            </Border>

                            <!-- Functional Stream Info Pill -->
                            <Button Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="0" CornerRadius="4" Padding="5,2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Audio Source &amp; Stream Info">
                                <TextBlock Text="{x:Bind ViewModel.AudioQualityBadge, Mode=OneWay}"
                                           FontSize="8" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Spacing="8" Width="220" Padding="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                                                <TextBlock Text="Stream Fidelity" FontWeight="Bold" FontSize="13" />
                                            </StackPanel>
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Grid ColumnSpacing="8" RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Bitrate:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.AudioQualityBadge, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Codec:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.AudioCodec, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Engine:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.AudioSource, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                            </Grid>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Row: Sleek 2.5px Progress Scrubber -->
                    <ProgressBar Grid.Row="1" Minimum="0" Maximum="100"
                                 Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                 Height="2.5" Margin="0,3,0,0"
                                 Foreground="{StaticResource AccentRedBrush}"
                                 Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                </Grid>
            </Border>

            <!-- 3. Right: Equalizer + Repeat + Download + Video + Options + Lyrics + Volume -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="3">
                <!-- Equalizer waveform icon -->
                <FontIcon Glyph="&#xE995;" FontSize="12" Foreground="{StaticResource AccentRedBrush}"
                          VerticalAlignment="Center" Margin="0,0,2,0"
                          Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <!-- Repeat Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        Command="{x:Bind ViewModel.ToggleRepeatCommand}"
                        ToolTipService.ToolTip="Repeat">
                    <FontIcon Glyph="&#xE8EE;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Download Track Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        Command="{x:Bind ViewModel.DownloadCurrentSongCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DownloadButtonToolTip, Mode=OneWay}">
                    <Grid>
                        <FontIcon Glyph="&#xE896;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsDownloading, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                      Width="13" Height="13" />
                    </Grid>
                </Button>

                <!-- Video / Now Playing Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        Click="NowPlaying_Click"
                        ToolTipService.ToolTip="Now Playing &amp; Music Video">
                    <FontIcon Glyph="&#xE714;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Options / Speed Flyout Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        ToolTipService.ToolTip="Playback Options &amp; Speed">
                    <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutSubItem Text="Playback Speed">
                                <MenuFlyoutItem Text="0.5x" Tag="0.5" Click="SpeedItem_Click" />
                                <MenuFlyoutItem Text="0.75x" Tag="0.75" Click="SpeedItem_Click" />
                                <MenuFlyoutItem Text="1.0x (Normal)" Tag="1.0" Click="SpeedItem_Click" />
                                <MenuFlyoutItem Text="1.25x" Tag="1.25" Click="SpeedItem_Click" />
                                <MenuFlyoutItem Text="1.5x" Tag="1.5" Click="SpeedItem_Click" />
                                <MenuFlyoutItem Text="2.0x" Tag="2.0" Click="SpeedItem_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Watch Music Video" Click="NowPlaying_Click" />
                            <MenuFlyoutItem Text="Toggle Synced Lyrics" Click="LyricsButton_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Queue / Up Next Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        ToolTipService.ToolTip="Up Next &amp; Playing Queue">
                    <FontIcon Glyph="&#xE90B;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <Grid Width="300" MaxHeight="380" Padding="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Queue Title -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE90B;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                                        <TextBlock Text="Playing Queue" FontWeight="Bold" FontSize="13" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Content="Clear" Click="ClearQueue_Click"
                                            Padding="8,2" FontSize="11" CornerRadius="6" Background="Transparent" BorderThickness="0" />
                                </Grid>

                                <!-- Currently Playing Box -->
                                <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{StaticResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Now" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Up Next List -->
                                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.PlaybackService.UpNext, Mode=OneWay}"
                                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="QueueItem_Click"
                                          MaxHeight="240">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Artist}" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Tag="{Binding VideoId}" Click="RemoveQueueItem_Click"
                                                        Background="Transparent" BorderThickness="0" Padding="4" CornerRadius="6">
                                                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Lyrics Toggle Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        Click="LyricsButton_Click"
                        ToolTipService.ToolTip="Lyrics">
                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Volume Mute Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="12"
                        Command="{x:Bind ViewModel.ToggleMuteCommand}"
                        ToolTipService.ToolTip="Mute / Unmute">
                    <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Compact Volume Slider -->
                <Slider Minimum="0" Maximum="1"
                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                        StepFrequency="0.01" Width="55"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
