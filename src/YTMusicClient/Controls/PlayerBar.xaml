<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTMusicClient.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Exact Apple Music Floating Acrylic Capsule Player (Image 4 Clone) -->
    <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Width="620"
            Height="58"
            Padding="14,6"
            HorizontalAlignment="Center">

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Left: Transport Controls -->
                <ColumnDefinition Width="*" />    <!-- Center: Artwork + Metadata + Mini Scrubber -->
                <ColumnDefinition Width="Auto" /> <!-- Right: Equalizer + Lyrics + Volume -->
            </Grid.ColumnDefinitions>

            <!-- 1. Left Transport Controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <!-- Previous Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="14" IsEnabled="False">
                    <FontIcon Glyph="&#xE892;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Solid Play / Pause Circle Button -->
                <Button Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                        Width="34" Height="34" CornerRadius="17"
                        Padding="0">
                    <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseGlyph}}"
                              FontSize="14" />
                </Button>

                <!-- Next Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="14" IsEnabled="False">
                    <FontIcon Glyph="&#xE893;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>

            <!-- 2. Center: Thumbnail, Song Title, Artist, and Mini Scrubber -->
            <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Small Square Artwork -->
                <Border CornerRadius="6" Width="38" Height="38">
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage UriSource="{x:Bind ViewModel.ThumbnailUrl, Mode=OneWay, Converter={StaticResource StringToUriConverter}}"
                                         DecodePixelWidth="38" />
                        </Image.Source>
                    </Image>
                </Border>

                <!-- Metadata & Scrubber Slider -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="1">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               FontWeight="Bold" FontSize="12"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="10"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />

                    <!-- Mini Scrubber Slider -->
                    <Slider Minimum="0" Maximum="100"
                            Value="{x:Bind ViewModel.ProgressPercent, Mode=TwoWay}"
                            Height="18" Margin="0,-6,0,0"
                            IsThumbToolTipEnabled="False" />
                </StackPanel>
            </Grid>

            <!-- 3. Right: Equalizer Icon, Lyrics, Volume -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <!-- Animated Equalizer Waveform indicator -->
                <TextBlock Text="ıllı" FontSize="14" Foreground="{StaticResource AccentRedBrush}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"
                           Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <!-- Lyrics Toggle Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="12"
                        ToolTipService.ToolTip="Lyrics">
                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Volume Mute Button -->
                <Button Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="12"
                        Command="{x:Bind ViewModel.ToggleMuteCommand}"
                        ToolTipService.ToolTip="Mute / Unmute">
                    <FontIcon Glyph="&#xE767;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Volume Mini Slider -->
                <Slider Minimum="0" Maximum="1"
                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                        StepFrequency="0.01" Width="70"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
