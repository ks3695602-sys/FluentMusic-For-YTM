<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTMusicClient.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:converters="using:YTMusicClient.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:ActiveLyricOpacityConverter x:Key="LyricOpacityConverter" />
            <converters:ActiveLyricFontSizeConverter x:Key="LyricFontSizeConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Padding="16" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
          CornerRadius="8,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <FontIcon Glyph="&#xEDC4;" FontSize="20"
                      Foreground="{StaticResource AccentRedBrush}" />
            <TextBlock Text="Lyrics" Style="{StaticResource SubtitleTextBlockStyle}"
                       FontWeight="SemiBold" />
        </StackPanel>

        <!-- Loading -->
        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      Width="32" Height="32"
                      VerticalAlignment="Top" Margin="0,32,0,0" />

        <!-- Status Message -->
        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   TextAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" />

        <!-- Lyrics List -->
        <ListView x:Name="LyricsListView"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Lyrics, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                  SelectionMode="None"
                  Padding="0,60,0,200">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LyricLine">
                    <TextBlock Text="{x:Bind Text}"
                               FontSize="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource LyricFontSizeConverter}}"
                               Opacity="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource LyricOpacityConverter}}"
                               TextWrapping="Wrap"
                               Padding="0,8"
                               Margin="0,2">
                    </TextBlock>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
