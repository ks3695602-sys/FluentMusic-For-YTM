<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTMusicClient.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:converters="using:YTMusicClient.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:ActiveLyricOpacityConverter x:Key="LyricOpacityConverter" />
            <converters:ActiveLyricFontSizeConverter x:Key="LyricFontSizeConverter" />
            <converters:ActiveAccentBrushConverter x:Key="ActiveAccentBrushConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Padding="20,16" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
          CornerRadius="16,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEDC4;" FontSize="18" Foreground="{StaticResource AccentRedBrush}" />
                <TextBlock Text="Lyrics" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                <Border Background="#20FA2D48" CornerRadius="10" Padding="6,2" Margin="6,0,0,0">
                    <TextBlock Text="Word-Sync" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Loading -->
        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      Width="32" Height="32"
                      VerticalAlignment="Top" Margin="0,40,0,0" />

        <!-- Status Message -->
        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   TextAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" />

        <!-- Lyrics List with Progressive Word-by-Word Karaoke Highlights -->
        <ListView x:Name="LyricsListView"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Lyrics, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                  SelectionMode="None"
                  Padding="0,40,0,180">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LyricLine">
                    <Grid Padding="0,6" Margin="0,2">
                        <TextBlock Text="{x:Bind Text}"
                                   FontSize="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource LyricFontSizeConverter}}"
                                   Opacity="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource LyricOpacityConverter}}"
                                   Foreground="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource ActiveAccentBrushConverter}}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
