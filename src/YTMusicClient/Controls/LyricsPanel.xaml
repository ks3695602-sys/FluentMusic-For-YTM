<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTMusicClient.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:local="using:YTMusicClient.Controls"
    xmlns:converters="using:YTMusicClient.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="22,18"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1,0,0,0"
            CornerRadius="12,0,0,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: Title, Animation Badge & Translation Capsule -->
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{StaticResource AccentRedBrush}" />
                        <TextBlock Text="Lyrics" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        <Border Background="#20FA2D48" CornerRadius="10" Padding="6,2" Margin="4,0,0,0">
                            <TextBlock x:Name="ModeBadgeText" Text="V2 Liquid Glow" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Translation Segmented Pill Capsule (ArchiveTune Multi-Language Engine) -->
                <Border Grid.Row="1" Margin="0,10,0,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="14" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="TransOriginalBtn" Content="Original" Click="TransPill_Click" Tag="Original"
                                CornerRadius="12" Padding="10,4" FontSize="11"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" FontWeight="SemiBold" BorderThickness="0" />
                        <Button x:Name="TransEnBtn" Content="EN" Click="TransPill_Click" Tag="EN"
                                CornerRadius="12" Padding="10,4" FontSize="11"
                                Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                        <Button x:Name="TransHiBtn" Content="हिन्दी" Click="TransPill_Click" Tag="HI"
                                CornerRadius="12" Padding="10,4" FontSize="11"
                                Background="Transparent" FontWeight="Medium" BorderThickness="0" />
                        <Button x:Name="TransHinglishBtn" Content="Hinglish" Click="TransPill_Click" Tag="Hinglish"
                                CornerRadius="12" Padding="10,4" FontSize="11"
                                Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Loading -->
            <ProgressRing Grid.Row="1"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          Width="32" Height="32"
                          VerticalAlignment="Top" Margin="0,40,0,0" />

            <!-- Status Message -->
            <TextBlock Grid.Row="1"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- Lyrics List with Progressive Word-by-Word Karaoke Highlights -->
            <ListView x:Name="LyricsListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Lyrics, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="LyricsListView_ItemClick"
                      Padding="0,40,0,180">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LyricLine">
                        <local:LyricItemView />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Border>
</UserControl>
