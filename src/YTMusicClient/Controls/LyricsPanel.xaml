<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTMusicClient.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:local="using:YTMusicClient.Controls"
    xmlns:converters="using:YTMusicClient.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="22,18"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1,0,0,0"
            CornerRadius="12,0,0,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: Dual Engine Capsule & Translation Capsule -->
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Dual Engine Tabs: 🌶️ Spicy Lyrics vs ⚡ YouLy+ -->
                <Border Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="16" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="EngineSpicyBtn" Content="🌶️ Spicy Lyrics" Click="EngineTab_Click" Tag="spicy"
                                CornerRadius="13" Padding="12,5" FontSize="11" FontWeight="SemiBold"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" />
                        <Button x:Name="EngineYouLyBtn" Content="⚡ YouLy+" Click="EngineTab_Click" Tag="youly"
                                CornerRadius="13" Padding="12,5" FontSize="11" FontWeight="Normal"
                                Background="Transparent" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Translation Segmented Pill Capsule -->
                <Border Grid.Row="1" Margin="0,8,0,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="14" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="TransOriginalBtn" Content="Original" Click="TransPill_Click" Tag="Original"
                                CornerRadius="12" Padding="10,4" FontSize="11"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" FontWeight="SemiBold" BorderThickness="0" />
                        <Button x:Name="TransEnBtn" Content="EN" Click="TransPill_Click" Tag="EN"
                                CornerRadius="12" Padding="10,4" FontSize="11"
                                Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                        <Button x:Name="TransHiBtn" Content="हिन्दी" Click="TransPill_Click" Tag="HI"
                                CornerRadius="12" Padding="10,4" FontSize="11"
                                Background="Transparent" FontWeight="Medium" BorderThickness="0" />
                        <Button x:Name="TransHinglishBtn" Content="Hinglish" Click="TransPill_Click" Tag="Hinglish"
                                CornerRadius="12" Padding="10,4" FontSize="11"
                                Background="Transparent" FontWeight="Normal" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Interactive WebView2 Container (Hosting Spicy Lyrics & YouLy+ Syllable Karaoke Engines) -->
            <WebView2 x:Name="SpicyLyricsWebView"
                      Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
