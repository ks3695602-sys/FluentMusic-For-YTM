<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTMusicClient.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YTMusicClient.Models"
    xmlns:local="using:YTMusicClient.Controls"
    xmlns:converters="using:YTMusicClient.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Glass Transparent Host for Interactive WebView2 (Hosting Apple Dynamic DOF Blur & Spicy Lyrics) -->
    <Border Background="Transparent"
            BorderThickness="0"
            Padding="0">
        <Grid>
            <WebView2 x:Name="SpicyLyricsWebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>