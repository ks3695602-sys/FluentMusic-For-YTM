<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="YTMusicClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:YTMusicClient.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:TimeSpanToStringConverter x:Key="TimeSpanConverter" />
            <converters:TimeSpanToStringConverter x:Key="TimeSpanToString" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:BoolToGlyphConverter x:Key="PlayPauseGlyph" TrueGlyph="&#xE769;" FalseGlyph="&#xE768;" />
            <converters:ActiveLyricOpacityConverter x:Key="LyricOpacityConverter" />
            <converters:ActiveLyricFontSizeConverter x:Key="LyricFontSizeConverter" />
            <converters:StringToUriConverter x:Key="StringToUriConverter" />
            <converters:RepeatModeToGlyphConverter x:Key="RepeatModeGlyphConverter" />
            <converters:ActiveAccentBrushConverter x:Key="ActiveAccentBrushConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

            <!-- Global Font Style: Segoe UI Variable -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
            </Style>

            <!-- Apple Music signature colors & gradients -->
            <Color x:Key="AccentRed">#FFFA2D48</Color>
            <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}" />
            <LinearGradientBrush x:Key="AppleAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFF2D55" Offset="0" />
                <GradientStop Color="#FFFF3B30" Offset="1" />
            </LinearGradientBrush>

            <!-- Depth and Solid Canvas Materials -->
            <SolidColorBrush x:Key="MainStageMatteBrush" Color="#FF0F0E0E" />
            <SolidColorBrush x:Key="SidebarMicaBrush" Color="#D9161618" />
            <SolidColorBrush x:Key="LiquidGlassPillBrush" Color="#A61A1A1A" />
            <AcrylicBrush x:Key="PillAcrylicBrush"
                          TintColor="#1A1A1A"
                          TintOpacity="0.65"
                          FallbackColor="#1F1F22" />
            <SolidColorBrush x:Key="LiquidGlassBrush" Color="#18202530" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="CardTranslucentBrush" Color="#1E232832" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
