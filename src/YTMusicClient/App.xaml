<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="YTMusicClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:YTMusicClient.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:TimeSpanToStringConverter x:Key="TimeSpanConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:BoolToGlyphConverter x:Key="PlayPauseGlyph" TrueGlyph="&#xE769;" FalseGlyph="&#xE768;" />
            <converters:ActiveLyricOpacityConverter x:Key="LyricOpacityConverter" />
            <converters:ActiveLyricFontSizeConverter x:Key="LyricFontSizeConverter" />
            <converters:StringToUriConverter x:Key="StringToUriConverter" />
            <converters:RepeatModeToGlyphConverter x:Key="RepeatModeGlyphConverter" />
            <converters:ActiveAccentBrushConverter x:Key="ActiveAccentBrushConverter" />
            <converters:ActiveLyricColorConverter x:Key="ActiveLyricColorConverter" />
            <converters:BoolToSemiBoldConverter x:Key="BoolToSemiBoldConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

            <!-- Apple Music signature colors -->
            <Color x:Key="AccentRed">#FFFA2D48</Color>
            <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}" />

            <!-- Translucent Glass Materials -->
            <SolidColorBrush x:Key="LiquidGlassBrush" Color="#18202530" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="CardTranslucentBrush" Color="#1E232832" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
